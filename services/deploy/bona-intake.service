; Bona WhatsApp intake — systemd USER unit (no root anywhere).
;
;   install -Dm644 ~/bona/services/deploy/bona-intake.service ~/.config/systemd/user/bona-intake.service
;   systemctl --user daemon-reload && systemctl --user enable --now bona-intake
;   journalctl --user -u bona-intake -f -o cat | jq .
;
; The service RUNS from ~/bona (the working checkout) and WRITES to $BONA_REPO
; (~/bona-bot, a dedicated clone) so a `git pull --rebase` during a publish can never
; rewrite the code of the process performing it.
;
; PATH must carry both the node bin dir (for `node` itself and `npx`) and ~/.local/bin
; (for `claude` and `uv`, which the pipeline shells out to). A user unit inherits almost
; nothing from the login shell, so an incomplete PATH here shows up as
; "spawn claude ENOENT" at the AI step and nowhere earlier.

[Unit]
Description=Bona WhatsApp PDF -> website listing intake
Documentation=file:%h/bona/services/intake/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/bona
Environment=NODE_ENV=production
Environment=PATH=%h/.nvm/versions/node/v24.19.0/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
; BONA_* settings; the service reads ~/.secrets/evolution-api.env itself.
; Leading "-": a missing secrets file must not stop the unit from starting — the daemon
; itself reports exactly which settings are missing, which is a far better error.
EnvironmentFile=-%h/.secrets/bona-services.env
ExecStart=%h/.nvm/versions/node/v24.19.0/bin/node %h/bona/services/intake/index.mjs
Restart=always
RestartSec=10
; SIGTERM makes the daemon stop taking work and wait up to 40 s for the job in flight
; (lib/shutdown.mjs) — never a process.exit() in the middle of a git push or a sharp encode.
KillSignal=SIGTERM
TimeoutStopSec=45

; ---- sandbox -----------------------------------------------------------------------
; This service reads PDFs from the internet and hands them to a model. Give it as little
; of the machine as it can still work with.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
; Everything the pipeline legitimately writes. ~/.claude* and the caches are the CLI's and
; uv's own state — without them `claude -p` and `uv run --with pymupdf` fail at startup.
; A "-" prefix means "only if it exists", so a fresh box still starts.
ReadWritePaths=%h/bona-data %h/bona-bot
ReadWritePaths=-%h/.claude -%h/.claude.json -%h/.cache -%h/.local/share -%h/.local/state -%h/.config
; RAM ceiling. The AI step spawns `claude`, which is another node process; if the journal
; shows the job being OOM-killed at the "ai" stage, raise this rather than removing it.
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bona-intake

[Install]
WantedBy=default.target
