[Unit]
Description=Bona concierge API (Dana) — chat, web calls, Retell tools
Documentation=https://github.com/azoz778/bona/blob/main/services/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Secrets are read by the process itself from ~/.secrets/*.env; the first file only
# carries non-secret configuration, the second the marketing keys (Meta CAPI, GA4
# Measurement Protocol, Snap CAPI — empty = that integration off). Both are optional
# so the unit starts either way.
EnvironmentFile=-%h/.secrets/bona-services.env
EnvironmentFile=-%h/.secrets/bona-marketing.env
Environment=NODE_ENV=production
# The WhatsApp poller (read-only chat/findMessages against Evolution, matches Ref codes
# to leads) runs inside this process. Set BONA_WA_POLL=0 in bona-services.env to stop it.
Environment=BONA_WA_POLL=1
Environment=PATH=%h/.nvm/versions/node/v24.19.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/bona/services
ExecStart=%h/.nvm/versions/node/v24.19.0/bin/node %h/bona/services/api/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

# Structured JSON logs, one object per line.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bona-api

# The service reads the repo and ~/.secrets, and writes exactly one directory.
# Verified on this machine with `systemd-analyze --user verify` and a dry
# `systemd-run --user` carrying the same directives.
PrivateTmp=true
NoNewPrivileges=true
ProtectHostname=true
RestrictSUIDSGID=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/bona-data
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=512M

[Install]
WantedBy=default.target
