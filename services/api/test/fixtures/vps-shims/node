#!/usr/bin/env bash
# Fake `node` (both the PC node and, symlinked into the fake HOME, the pinned VPS node):
#   -v / --version                 → v24.19.0
#   -e 'require("node:sqlite")'    → exit 0
#   -e '<count script>' <bona.db>  → prints 7 (the lead count)
#   --test …                       → exit $SHIM_NODE_TEST_FAIL (default 0)
#   anything else                  → exit 0 without doing anything
set -u
[ -n "${SHIM_LOG:-}" ] && printf 'node %s\n' "$*" >> "$SHIM_LOG"
case "${1:-}" in
  -v | --version) echo v24.19.0 ;;
  --test) exit "${SHIM_NODE_TEST_FAIL:-0}" ;;
  -e) [ $# -ge 3 ] && echo 7 ;;
esac
exit 0
