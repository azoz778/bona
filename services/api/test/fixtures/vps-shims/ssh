#!/usr/bin/env bash
# Fake `ssh` for the cutover/rollback tests — never opens a connection. Appends its argv as one
# line to $SHIM_LOG, then answers the REMOTE command string (the last argument) the way the VPS
# would:
#   true, install -d …, chmod …, journalctl …           → exit 0
#   bash …/install-vps.sh --check                       → exit 0 (ready)
#   systemctl --user is-active --quiet U                → exit 1 (inactive) unless the scenario says active
#   ! systemctl … is-active … && ! systemctl … is-active → the "verified inactive" check: exit 0 unless active
#   systemctl --user enable --now … / disable --now …   → exit 0 (the log line is the record)
#   curl … /health …                                    → prints {"ok":true}
#   ~/.local/opt/node-…/bin/node -e … ~/bona-data/bona.db → prints 7 (the lead count)
#   test -f ~/bona-data/NAME                            → exit 0 (present) unless NAME is in SHIM_REMOTE_MISSING
#   anything else                                       → exit 99 (the test sees an unexpected command)
# Scenarios (environment):
#   SHIM_VPS_STOP_FAILS=1        once a `disable --now` was sent, the units report ACTIVE anyway
#   SHIM_SSH_DOWN_AFTER_START=1  every call after an `enable --now bona-api` was sent exits 255
#   SHIM_REMOTE_MISSING="a b"    space-separated data file names that `test -f ~/bona-data/NAME` reports absent
set -u
log=${SHIM_LOG:?SHIM_LOG must point at the log file}
cmd=${!#}
seen() { grep -q -- "^ssh .*$1" "$log" 2>/dev/null; }
down=0
if [ "${SHIM_SSH_DOWN_AFTER_START:-0}" = 1 ] && seen 'enable --now bona-api'; then down=1; fi
printf 'ssh %s\n' "$*" >> "$log"
if [ "$down" = 1 ]; then echo "ssh: connect to host $2 port 22: Connection refused (shim)" >&2; exit 255; fi
active=0
if [ "${SHIM_VPS_STOP_FAILS:-0}" = 1 ] && seen 'disable --now'; then active=1; fi
case "$cmd" in
  true | install\ -d* | chmod* | journalctl*) exit 0 ;;
  *install-vps.sh\ --check*) exit 0 ;;
  '! systemctl'*is-active*) exit "$active" ;;
  systemctl*is-active*) [ "$active" = 1 ] && exit 0 || exit 1 ;;
  systemctl*enable\ --now* | systemctl*disable\ --now*) exit 0 ;;
  curl*/health*) echo '{"ok":true}'; exit 0 ;;
  *node\ -e*bona.db) echo 7; exit 0 ;;
  test\ -f\ ~/bona-data/*)
    name=${cmd##*/}
    case " ${SHIM_REMOTE_MISSING:-} " in *" $name "*) exit 1 ;; *) exit 0 ;; esac ;;
  *) echo "ssh shim: unexpected remote command: $cmd" >&2; exit 99 ;;
esac
