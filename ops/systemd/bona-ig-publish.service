; Bona — unattended Instagram publisher. systemd USER unit (no root anywhere).
;
; Fired by bona-ig-publish.timer every 15 min, 17:00–23:59 Asia/Riyadh. Each run reads
; src/data/content-calendar.json from the publish tree (~/bona-publish, see below), publishes
; what is due (max 3, 60 s apart), appends to the ledger at ~/bona-data/ig/published.jsonl
; (outside any repo) and exits. See scripts/social/README.md → "Publishing — Instagram".
;
;   bash ~/bona/ops/systemd/install.sh            # publish tree, ledger seed, units, enable
;   systemctl --user list-timers bona-ig-publish.timer
;   journalctl --user -u bona-ig-publish -o cat -n 50
;   systemctl --user start bona-ig-publish.service # run once, now
;   systemctl --user stop  bona-ig-publish.timer   # pause
;
; ~/bona-publish is a `git worktree` of ~/bona pinned (detached) to origin/main. ~/bona itself
; is a shared tree that sits on feature branches most evenings, and the calendar comes from the
; working tree, so the timer must not read it from there. sync-publish-tree.sh brings the
; publish tree to origin/main before each run (best-effort: "-" and a 60 s timeout, so no
; network means "run what is there"); guard-main.sh then refuses to run unless the tree is
; exactly at origin/main (or on main) and clean. Nothing in the publish tree is ever edited by
; hand, and the publisher needs no node_modules there (Node builtins + scripts/social/lib).
;
; A user unit inherits almost nothing from the login shell. node is nvm-managed here
; (~/.local/bin/node -> ~/.nvm/versions/node/vX/bin/node), so PATH is set explicitly and
; ExecStart goes through /usr/bin/env — if node is upgraded, fix the two paths on the PATH line.
; TZ is set for the log lines only; the script itself does its due-time maths in Asia/Riyadh
; regardless of the machine zone.

[Unit]
Description=Bona — publish due Instagram calendar entries
Documentation=file:%h/bona-publish/scripts/social/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/bona-publish
Environment=TZ=Asia/Riyadh
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
; META_ACCESS_TOKEN, IG_BUSINESS_ID (and optionally GRAPH_VERSION). No "-" prefix on purpose:
; a missing token file must FAIL the unit loudly, not silently run in dry-run mode every 15 min.
; --live below does the same for a file that exists but has an EMPTY token: exit 1, not dry-run.
EnvironmentFile=%h/.secrets/bona-meta-graph.env
; 1. bring the publish tree to origin/main — best-effort: "-" means a failure (no network, no
;    credentials, the 60 s timeout) does not block the run; the guard still checks the result.
ExecStartPre=-/usr/bin/timeout 60 /usr/bin/env bash %h/bona-publish/ops/systemd/sync-publish-tree.sh %h/bona-publish
; 2. refuse to run unless the tree is exactly origin/main (or on main) and clean — logs why.
ExecStartPre=/usr/bin/env bash %h/bona-publish/ops/systemd/guard-main.sh %h/bona-publish
; --grace 3: the timer's last tick is 23:45 and the latest slot is 21:05, so 3 h is the most
; grace a slot can use inside the window; the publisher refuses to post outside 17:00–23:59 KSA
; anyway (deferred:quiet-hours), which is what makes Persistent=true safe at a 02:00 boot.
ExecStart=/usr/bin/env node scripts/social/publish.mjs --live --grace 3 --limit 3
; Containers are polled every 3 s (single image / story) or 5 s (carousel items and the
; carousel parent), 2 min budget per container. A run is normally well under a minute; the
; theoretical worst case (3 publishes, 6-slide carousels, every container slow) is ~45 min,
; which no real run reaches. 25 min bounds it: beyond that something is wrong, SIGTERM lands
; between entries (or mid-publish with the in-flight line already written — reconciled next
; run) and the next tick finds the lock held by a live pid and steps aside. Overlap is safe.
TimeoutStartSec=25min
; On stop (the start timeout above, `systemctl --user stop`, shutdown) the publisher gets
; SIGTERM, finishes the entry it is on — the in-flight ledger line is written before
; media_publish, so a kill mid-publish is reconciled next run, never re-posted — and exits.
; A single publish is bounded by one container wait (2 min) + the API call, so 3 min is enough.
TimeoutStopSec=3min
; Exit 2 = a publish error was recorded in the ledger (systemd shows the unit as failed, which
; is what we want to see in `systemctl --user --failed`). Exit 0 = ok / nothing due.
SuccessExitStatus=0

; ---- sandbox -----------------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
; What gets written: the ledger + lock (install.sh creates the directory — ReadWritePaths needs
; it to exist), the publish tree (the sync step checks origin/main out into it) and the
; repository's .git, which the worktree shares with ~/bona (fetched objects, refs, the
; worktree's own HEAD/index). ~/bona's working files stay read-only.
ReadWritePaths=%h/bona-data/ig %h/bona-publish %h/bona/.git
MemoryHigh=256M
MemoryMax=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bona-ig-publish
