[Unit]
Description=Bona reviewed daily %i publisher
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=%h/bona-publish
Environment=TZ=Asia/Riyadh
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.secrets/bona-meta-graph.env
ExecStartPre=-/usr/bin/timeout 60 /usr/bin/env bash %h/bona-publish/ops/systemd/sync-publish-tree.sh %h/bona-publish
ExecStartPre=/usr/bin/env bash %h/bona-publish/ops/systemd/guard-main.sh %h/bona-publish
ExecStart=/usr/bin/env node scripts/social/daily-publish.mjs %i
TimeoutStartSec=20min
TimeoutStopSec=3min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/bona-data %h/bona-publish %h/bona/.git
MemoryMax=512M
StandardOutput=journal
StandardError=journal
