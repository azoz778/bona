[Unit]
Description=Bona daily TikTok post at 21:45 Riyadh (after Isha), two bounded retries
[Timer]
OnCalendar=*-*-* 21:45 Asia/Riyadh
OnCalendar=*-*-* 22:15 Asia/Riyadh
OnCalendar=*-*-* 22:45 Asia/Riyadh
Persistent=true
AccuracySec=30s
Unit=bona-browser@tiktok.service
[Install]
WantedBy=timers.target
