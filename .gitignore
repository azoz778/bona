node_modules/
node_modules
dist/
.astro/
.env
.DS_Store
*.log
.builds/
__pycache__/

# Social content engine (scripts/social) — generated media is heavy and reproducible.
# The queue JSON and the code ARE committed; hundreds of MB of MP4/PNG are not.
marketing/queue/*
!marketing/queue/queue.json
!marketing/queue/README.md
# The Instagram publisher's ledger is NOT here: it lives in ~/bona-data/ig/published.jsonl,
# outside the working tree (scripts/social/lib/ledger.mjs), so a branch switch cannot hide it.
scripts/social/.cache/
# ops/ is scratch (browser step scripts, screenshots, session notes) — except the systemd
# units for the unattended publisher, which are part of the product.
ops/*
!ops/systemd/
