---
/* Listings by district (top 8). Thin wrapper over BarChart so the overview
   keeps its existing import; the kind chart uses BarChart directly. */
import BarChart from './BarChart.astro';
interface Row { district: string; count: number }
interface Props { rows: Row[]; total: number }
const { rows, total } = Astro.props;
const shown = rows.reduce((a, r) => a + r.count, 0);
---
<BarChart
  id="districts"
  title="Listings by district"
  subtitle={rows.length ? `Top ${rows.length} districts, ${shown} of ${total} listings` : undefined}
  rows={rows.map(r => ({ label: r.district, count: r.count }))}
  total={total}
  emptyText="No listings yet. The chart fills in as soon as listings.json has data."
>
  <Fragment slot="column">District</Fragment>
</BarChart>
