---
/* Horizontal bar chart, one series — so one hue and no legend (the title names
   the series). Marks: 18px bars, 4px rounded data-end, square at the baseline,
   value at the tip in ink, hairline baseline. Hover/focus tooltip is wired in
   client/chart.ts for every [data-chart]; the table view below keeps every
   value reachable without hovering. DistrictChart and the "Inventory by kind"
   chart both render through this component. */
interface Row { label: string; count: number }
interface Props {
  id: string;            // data-chart id, unique per page
  title: string;
  subtitle?: string;
  rows: Row[];
  total: number;         // denominator for the share column
  noun?: string;         // "listing" -> tooltip "3 listings"
  labelWidth?: number;   // px reserved for category labels
  emptyText?: string;
  width?: number;
}
const { id, title, subtitle, rows, total, noun = 'listing', labelWidth = 180, emptyText = 'No data yet.', width = 720 } = Astro.props;

const W = width, LABEL_W = labelWidth, VALUE_W = 44, ROW_H = 32, BAR_H = 18, PAD = 8, R = 4;
const H = rows.length ? PAD * 2 + rows.length * ROW_H : 0;
const max = Math.max(1, ...rows.map(r => r.count));
const barMax = W - LABEL_W - VALUE_W - 12;
const clip = (s: string, n = 24) => (s.length > n ? s.slice(0, n - 1) + '…' : s);

function barPath(x: number, y: number, w: number, h: number): string {
  if (w <= R) return `M${x} ${y}h${w}v${h}h${-w}z`;
  return `M${x} ${y}H${x + w - R}A${R} ${R} 0 0 1 ${x + w} ${y + R}V${y + h - R}A${R} ${R} 0 0 1 ${x + w - R} ${y + h}H${x}Z`;
}
const bars = rows.map((r, i) => {
  const y = PAD + i * ROW_H + (ROW_H - BAR_H) / 2;
  const w = Math.max(2, Math.round((r.count / max) * barMax));
  return { ...r, y, w, path: barPath(LABEL_W, y, w, BAR_H), rowY: PAD + i * ROW_H };
});
const plural = (n: number) => `${n} ${n === 1 ? noun : `${noun}s`}`;
const titleId = `${id}-chart-title`;
---
<div class="dash-panel" data-chart={id} data-noun={noun}>
  <div class="dash-panel-head">
    <div>
      <h3 class="dash-h3">{title}</h3>
      {subtitle && <div class="dash-muted" style="font-size:12px">{subtitle}</div>}
    </div>
  </div>
  {rows.length === 0 ? (
    <div class="dash-empty"><p>{emptyText}</p></div>
  ) : (
    <div class="dash-chart">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={titleId} xmlns="http://www.w3.org/2000/svg">
        <title id={titleId}>{title}</title>
        <line class="axis" x1={LABEL_W - 0.5} y1={PAD} x2={LABEL_W - 0.5} y2={H - PAD} />
        {bars.map(b => (
          <g class="bar" tabindex="0" role="listitem" data-label={b.label} data-value={String(b.count)} aria-label={`${b.label}: ${plural(b.count)}`}>
            <rect class="hit" x="0" y={b.rowY} width={W} height={ROW_H} />
            <text class="lbl" x={LABEL_W - 12} y={b.y + BAR_H / 2} text-anchor="end" dominant-baseline="central">{clip(b.label)}</text>
            <path d={b.path} />
            <text class="val" x={LABEL_W + b.w + 8} y={b.y + BAR_H / 2} dominant-baseline="central">{b.count}</text>
          </g>
        ))}
      </svg>
      <div class="dash-tip" data-chart-tip hidden></div>
    </div>
  )}
  {rows.length > 0 && (
    <details class="dash-details">
      <summary>View as table</summary>
      <table class="dash-table">
        <thead><tr><th scope="col"><slot name="column">Label</slot></th><th scope="col" style="text-align:right">Listings</th><th scope="col" style="text-align:right">Share</th></tr></thead>
        <tbody>
          {rows.map(r => (
            <tr><td>{r.label}</td><td class="dash-num" style="text-align:right">{r.count}</td><td class="dash-num dash-muted" style="text-align:right">{total ? Math.round((r.count / total) * 100) : 0}%</td></tr>
          ))}
        </tbody>
      </table>
    </details>
  )}
</div>
