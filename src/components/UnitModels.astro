---
/* "Residences & prices": every unit model a development brochure prints (WhatsApp intake, `models` in
   src/data/listings.json; shape in src/data/LISTING-SCHEMA.md → "Unit models and the project fact lists"),
   with its size, rooms, both printed prices (regular and Sakani) and its floor plan, then the brochure's
   amenities / nearby / warranties lists. A table when the column is 48rem or wider, stacked cards below; both
   are in the HTML (each row carries data-model-row="table" | "card", test/unit-models.test.mjs counts them).
   Renders nothing when the listing has no models and no fact lists. */
import { t, ui, formatNumber, formatPrice, otherLocale, type Locale } from '../lib/i18n';
import type { Listing, UnitModel } from '../lib/listings';

interface Props { listing: Listing; locale: Locale; class?: string }
const { listing: l, locale, class: cls = '' } = Astro.props;

const ar = locale === 'ar';
const other = otherLocale(locale);
const models: UnitModel[] = Array.isArray(l.models) ? l.models : [];
const currency = l.price?.currency || 'SAR';
const isFigure = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n) && n > 0;
const isCount = (n: unknown): n is number => typeof n === 'number' && Number.isInteger(n) && n >= 0;

const hasSakani = models.some((m) => isFigure(m.subsidisedPrice));
const hasPrice = models.some((m) => isFigure(m.price));
const sqm = ar ? 'م²' : 'm²';
/* Brochures print areas to two decimals (175.40); whole areas stay whole. Western digits in both locales. */
const areaFigure = (a: number) => (Number.isInteger(a)
  ? formatNumber(a)
  : new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(a));
const cash = (n: number | null | undefined) => (isFigure(n) ? formatPrice({ amount: n, currency }, locale) : t(ui.onRequestShort, locale));
const name = (m: UnitModel) => t(m.name, locale);
const otherName = (m: UnitModel) => {
  const o = m.name?.[other]?.trim();
  return o && o !== name(m).trim() ? o : '';
};
const rooms = (m: UnitModel) => (m.rooms?.[locale] ?? m.rooms?.en ?? []).filter(Boolean).join(' · ');
const availability = (m: UnitModel) => (m.availability ? t(m.availability, locale) : '');
const planAlt = (m: UnitModel) => (ar ? `مخطط ${name(m)}` : `${name(m)} floor plan`);

/* Card line: "3 bedrooms · 2 bathrooms" / "3 غرف نوم · دورتا مياه" (Arabic dual and 3–10 plural; 11+ singular). */
function bedsText(n: number): string {
  if (n === 0) return ar ? 'استوديو' : 'Studio';
  if (!ar) return `${n} ${n === 1 ? 'bedroom' : 'bedrooms'}`;
  return n === 1 ? 'غرفة نوم واحدة' : n === 2 ? 'غرفتا نوم' : n <= 10 ? `${n} غرف نوم` : `${n} غرفة نوم`;
}
function bathsText(n: number): string {
  if (!ar) return `${n} ${n === 1 ? 'bathroom' : 'bathrooms'}`;
  return n === 1 ? 'دورة مياه واحدة' : n === 2 ? 'دورتا مياه' : n <= 10 ? `${n} دورات مياه` : `${n} دورة مياه`;
}
const specParts = (m: UnitModel) => [
  isCount(m.bedrooms) ? bedsText(m.bedrooms) : '',
  isCount(m.bathrooms) && m.bathrooms > 0 ? bathsText(m.bathrooms) : '',
].filter(Boolean);

const listOf = (v?: { en: string[]; ar: string[] } | null) => (v?.[locale] ?? v?.en ?? []).filter((x) => typeof x === 'string' && x.trim());
const facts = [
  { key: 'amenities', heading: t(ui.amenitiesHeading, locale), items: listOf(l.amenities) },
  { key: 'nearby', heading: t(ui.nearbyHeading, locale), items: listOf(l.nearby) },
  { key: 'warranties', heading: t(ui.warrantiesHeading, locale), items: listOf(l.warranties) },
].filter((f) => f.items.length > 0);

const show = models.length > 0 || facts.length > 0;
const headingId = `residences-${l.id}`;
/* With models the fact lists sit under the section heading (h3); on their own they are the section's headings. */
const FactHeading = models.length > 0 ? 'h3' : 'h2';
---
{show && (
  <section id="residences" class={`@container scroll-mt-28 ${cls}`} aria-labelledby={models.length > 0 ? headingId : undefined} data-unit-models>
    {models.length > 0 && (
      <>
        <h2 id={headingId} class="label text-stone-2">{t(ui.residencesPrices, locale)}</h2>

        {/* a column 48rem or wider: one table. Measured on the column, not the viewport: from lg to xl the page puts
            this column beside the enquiry panel at ~530 px, where seven columns do not fit. */}
        <div class="mt-5 hidden overflow-x-auto @3xl:block">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-ink/15 text-xs text-stone-2">
                <th scope="col" class="py-2 pe-4 text-start font-medium">{t(ui.layoutCol, locale)}</th>
                <th scope="col" class="py-2 pe-4 text-end font-medium">{t(ui.bedroomsCol, locale)}</th>
                <th scope="col" class="py-2 pe-4 text-end font-medium">{t(ui.bathroomsCol, locale)}</th>
                <th scope="col" class="py-2 pe-4 text-end font-medium">{t(ui.areaCol, locale)}</th>
                <th scope="col" class="py-2 pe-4 text-end font-medium">{t(ui.priceCol, locale)}</th>
                {hasSakani && <th scope="col" class="py-2 pe-4 text-end font-medium">{t(ui.sakaniCol, locale)}</th>}
                <th scope="col" class="py-2 text-end font-medium">{t(ui.planCol, locale)}</th>
              </tr>
            </thead>
            <tbody>
              {models.map((m) => (
                <tr class="border-b border-ink/10 align-middle" data-model-row="table">
                  <th scope="row" class="py-3 pe-4 text-start font-normal">
                    <span class="text-[15px] font-semibold text-ink">{name(m)}</span>
                    {otherName(m) && <span class="ms-2 text-xs text-stone-2"><bdi lang={other}>{otherName(m)}</bdi></span>}
                    {rooms(m) && <span class="mt-1 block text-xs text-stone-2">{rooms(m)}</span>}
                    {availability(m) && <span class="mt-0.5 block text-xs text-stone-2">{availability(m)}</span>}
                  </th>
                  <td class="py-3 pe-4 text-end tabular-nums">{isCount(m.bedrooms) ? formatNumber(m.bedrooms) : '—'}</td>
                  <td class="py-3 pe-4 text-end tabular-nums">{isCount(m.bathrooms) ? formatNumber(m.bathrooms) : '—'}</td>
                  <td class="whitespace-nowrap py-3 pe-4 text-end tabular-nums">{isFigure(m.areaSqm) ? <><span dir="ltr">{areaFigure(m.areaSqm)}</span> {sqm}</> : '—'}</td>
                  <td class="whitespace-nowrap py-3 pe-4 text-end tabular-nums">{cash(m.price)}</td>
                  {hasSakani && <td class="whitespace-nowrap py-3 pe-4 text-end tabular-nums">{isFigure(m.subsidisedPrice) ? cash(m.subsidisedPrice) : '—'}</td>}
                  <td class="py-2 text-end">
                    {m.floorPlan?.src ? (
                      <a href={m.floorPlan.src} target="_blank" rel="noopener" class="inline-block border border-ink/10 bg-white p-1 align-middle transition-colors hover:border-ink/40" data-cta="listing_floor_plan" data-listing={l.id}>
                        <img src={m.floorPlan.thumb || m.floorPlan.src} alt={planAlt(m)} loading="lazy" decoding="async" width="108" height="72" class="block h-[72px] w-[108px]" style="object-fit:contain" />
                      </a>
                    ) : <span class="text-stone-2">—</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* a narrower column (phones, and lg–xl beside the panel): stacked cards */}
        <div class="mt-5 border-t border-ink/15 @3xl:hidden">
          {models.map((m) => (
            <article class="border-b border-ink/10 py-4" data-model-row="card">
              <h3 class="text-base font-semibold">{name(m)}</h3>
              {(specParts(m).length > 0 || isFigure(m.areaSqm)) && (
                <p class="mt-1 text-sm text-stone-2">
                  {specParts(m).join(' · ')}{specParts(m).length > 0 && isFigure(m.areaSqm) && ' · '}{isFigure(m.areaSqm) && <><span dir="ltr">{areaFigure(m.areaSqm)}</span> {sqm}</>}
                </p>
              )}
              {rooms(m) && <p class="mt-1 text-xs text-stone-2">{rooms(m)}</p>}
              {availability(m) && <p class="mt-0.5 text-xs text-stone-2">{availability(m)}</p>}
              <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3">
                <div>
                  <dt class="text-xs text-stone-2">{t(ui.priceCol, locale)}</dt>
                  <dd class="mt-0.5 text-[15px] font-semibold tabular-nums">{cash(m.price)}</dd>
                </div>
                {isFigure(m.subsidisedPrice) && (
                  <div>
                    <dt class="text-xs text-stone-2">{t(ui.sakaniCol, locale)}</dt>
                    <dd class="mt-0.5 text-[15px] tabular-nums">{cash(m.subsidisedPrice)}</dd>
                  </div>
                )}
              </dl>
              {m.floorPlan?.src && (
                <a href={m.floorPlan.src} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-4" data-cta="listing_floor_plan" data-listing={l.id}>
                  <span class="border border-ink/10 bg-white p-1"><img src={m.floorPlan.thumb || m.floorPlan.src} alt={planAlt(m)} loading="lazy" decoding="async" width="108" height="72" class="block h-[72px] w-[108px]" style="object-fit:contain" /></span>
                  <span class="link-label text-ink">{t(ui.viewPlan, locale)}</span>
                </a>
              )}
            </article>
          ))}
        </div>

        {hasPrice && <p class="mt-4 max-w-[60ch] text-sm leading-relaxed text-stone-2" data-models-note>{t(ui.modelsNote, locale)}</p>}
      </>
    )}

    {facts.length > 0 && (
      <div class:list={['grid gap-x-10 gap-y-8 sm:grid-cols-2 xl:grid-cols-3', models.length > 0 && 'mt-10']} data-unit-facts>
        {facts.map((f) => (
          <div data-fact-list={f.key}>
            <FactHeading class="label text-stone-2">{f.heading}</FactHeading>
            <ul class="mt-4 space-y-2.5 text-sm leading-relaxed">
              {f.items.map((item) => <li class="flex items-start gap-3"><span class="rule mt-[0.7em] !w-3 shrink-0"></span><span>{item}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>
)}
