---
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../EnquiryForm.astro';
import Icon from '../Icon.astro';
import site from '../../data/site.json';
import { localePath, t, ui, waLink, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd, orgJsonLd } from '../../lib/seo';
interface Props { locale: Locale }
const { locale } = Astro.props;
const path = localePath(locale, '/contact/');
const wa = waLink(site.whatsapp.wa, t(ui.formGreeting, locale));
const addr = site.address[locale];
const mapsEmbed = `https://www.google.com/maps?q=${site.geo.lat},${site.geo.lng}&z=14&hl=${locale}&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${site.geo.lat},${site.geo.lng}`;
const crumbs = [{ name: t(ui.home, locale), path: localePath(locale, '/') }, { name: t(ui.contactTitle, locale), path }];
---
<Base title={`${t(ui.contactMetaTitle, locale)} — ${locale === 'ar' ? site.nameAr : site.name}`} description={t(ui.contactMetaDesc, locale)} locale={locale} path={path} jsonLd={[orgJsonLd(locale), breadcrumbJsonLd(crumbs)]}>
  <section class="section-tight pt-12 lg:pt-16">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <span class="rule"></span>
        <h1 class="display-lg mt-6">{t(ui.contactTitle, locale)}</h1>
        <p class="statement mt-8 max-w-[34ch]">{t(ui.contactIntro, locale)}</p>
      </div>

      <div class="mt-14 grid gap-14 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-5" data-reveal>
          <a href={wa} target="_blank" rel="noopener" class="btn btn-ink w-full !py-5 !text-xs sm:w-auto"><Icon name="whatsapp" size={20} />{t(ui.chatOnWhatsApp, locale)}</a>
          <p class="mt-3 text-xs text-stone">{t(ui.contactBandText, locale)}</p>
          {site.concierge?.enabled !== false && (
            <p class="mt-5"><button type="button" class="link-label text-ink" data-concierge-trigger>{t(ui.conciergeAskDana, locale)}</button></p>
          )}

          <dl class="mt-12 space-y-9">
            <div>
              <dt class="label text-stone-2">{t(ui.phone, locale)}</dt>
              <dd class="mt-2"><a href={`tel:${site.phone.e164}`} class="link display-md" dir="ltr">{site.phone.display}</a></dd>
            </div>
            {site.email && (
              <div>
                <dt class="label text-stone-2">{t(ui.email, locale)}</dt>
                <dd class="mt-2"><a href={`mailto:${site.email}`} class="link display-md" dir="ltr">{site.email}</a></dd>
              </div>
            )}
            <div>
              <dt class="label text-stone-2">{t(ui.instagram, locale)}</dt>
              <dd class="mt-2"><a href={site.instagram.url} target="_blank" rel="noopener" class="link display-md" dir="ltr">@{site.instagram.handle}</a></dd>
            </div>
            <div>
              <dt class="label text-stone-2">{t(ui.address, locale)}</dt>
              <dd class="mt-2 text-[15px] leading-relaxed">
                <address class="not-italic">{addr.street}<br />{addr.city} {addr.postalCode}, {addr.region}<br />{addr.country}</address>
                <a href={mapsLink} target="_blank" rel="noopener" class="link-label mt-4 inline-block text-ink">{t(ui.openInMaps, locale)}</a>
              </dd>
            </div>
            <div>
              <dt class="label text-stone-2">{t(ui.hours, locale)}</dt>
              <dd class="mt-2 text-[15px]">{t(site.hours, locale)}</dd>
            </div>
          </dl>
        </div>
        <div class="lg:col-span-7" data-reveal data-reveal-delay="1">
          <div class="aspect-[4/3] w-full bg-ivory-2 lg:aspect-[5/4]">
            <iframe src={mapsEmbed} title={t(ui.mapTitle, locale)} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen class="h-full w-full border-0 grayscale-[35%] contrast-[95%]"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section border-t border-ink/10">
    <div class="wrap-narrow">
      <div data-reveal>
        <span class="rule"></span>
        <h2 class="display-lg mt-6">{t(ui.sendMessage, locale)}</h2>
      </div>
      <div class="mt-12"><EnquiryForm path={path} locale={locale} variant="contact" id="enquiry-contact" /></div>
    </div>
  </section>
</Base>
