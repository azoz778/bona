---
/* Listing index. Three modes: all (/properties/), category (/properties/for-sale/ …) and kind (/properties/houses/ …).
   In kind mode the category chips filter client-side (buy / rent / off-plan …) and mirror to ?category= in the URL. */
import Base from '../../layouts/Base.astro';
import ListingCard from '../ListingCard.astro';
import SectionHead from '../SectionHead.astro';
import site from '../../data/site.json';
import { localePath, t, ui, type Locale, count, countForms_ } from '../../lib/i18n';
import { listings, ordered, categories, categoryLabel, categorySlug, typesIn, typeLabel, kindOf, kindSlug, categoriesIn, type Listing, type Kind } from '../../lib/listings';
import { breadcrumbJsonLd } from '../../lib/seo';
interface Props { locale: Locale; category?: Listing['category']; kind?: Kind }
const { locale, category, kind } = Astro.props;
const all = !category && !kind;
const items = ordered(listings.filter(l => (!category || l.category === category) && (!kind || kindOf(l) === kind)));
const path = localePath(locale, kind ? `/properties/${kindSlug[kind]}/` : all ? '/properties/' : `/properties/${categorySlug[category!]}/`);
const copy = {
  buy: { title: ui.forSaleTitle, intro: ui.forSaleIntro }, rent: { title: ui.forRentTitle, intro: ui.forRentIntro },
  'off-plan': { title: ui.offPlanTitle, intro: ui.offPlanIntro }, international: { title: ui.internationalTitle, intro: ui.internationalIntro },
} as const;
const kindCopy = {
  house: { title: ui.housesPageTitle, intro: ui.housesPageIntro }, apartment: { title: ui.apartmentsPageTitle, intro: ui.apartmentsPageIntro },
  land: { title: ui.landPageTitle, intro: ui.landPageIntro }, building: { title: ui.buildingsPageTitle, intro: ui.buildingsPageIntro },
} as const;
const title = kind ? t(kindCopy[kind].title, locale) : all ? t(ui.properties, locale) : t(copy[category!].title, locale);
const intro = kind ? t(kindCopy[kind].intro, locale) : all ? t(ui.propertiesIntro, locale) : t(copy[category!].intro, locale);
const types = typesIn(items);
const chipCats = kind ? categoriesIn(items) : categories;
const crumbs = [{ name: t(ui.home, locale), path: localePath(locale, '/') }, { name: t(ui.properties, locale), path: localePath(locale, '/properties/') }];
if (!all) crumbs.push({ name: title, path });
const countText = (n: number) => count(n, 'residence', locale);
const arForms = JSON.stringify(countForms_('residence').ar);
const chipCls = 'chip';
---
<Base title={`${title} — ${locale === 'ar' ? site.nameAr : site.name}`} description={intro} locale={locale} path={path} image={items[0]?.images?.[0]?.src} jsonLd={breadcrumbJsonLd(crumbs)}>
  <section class="section-tight pt-12 lg:pt-16" data-properties data-mode={kind ? 'kind' : all ? 'all' : 'category'} data-category={category ?? ''} data-count-many={t(ui.residencesCount, locale)} data-count-one={t(ui.residenceCountOne, locale)} data-count-ar={locale === 'ar' ? arForms : undefined}>
    <div class="wrap">
      <SectionHead as="h1" title={title} intro={intro} />

      <div class="mt-12 flex flex-col gap-5 border-y border-ink/10 py-3 lg:flex-row lg:items-center lg:justify-between">
        {kind ? (
          <div role="group" aria-label={locale === 'ar' ? 'الفئة' : 'Category'} class="flex flex-wrap gap-x-7 gap-y-1">
            <button type="button" class={chipCls} data-cat="" aria-pressed="true">{t(ui.all, locale)}</button>
            {chipCats.map(c => <button type="button" class={chipCls} data-cat={c} aria-pressed="false">{t(categoryLabel[c], locale)}</button>)}
          </div>
        ) : (
          <nav aria-label={locale === 'ar' ? 'الفئة' : 'Category'} class="flex flex-wrap gap-x-7 gap-y-1">
            <a href={localePath(locale, '/properties/')} class={chipCls} data-cat="" aria-current={all ? 'true' : undefined}>{t(ui.all, locale)}</a>
            {chipCats.map(c => (
              <a href={localePath(locale, `/properties/${categorySlug[c]}/`)} class={chipCls} data-cat={c} aria-current={category === c ? 'true' : undefined}>{t(categoryLabel[c], locale)}</a>
            ))}
          </nav>
        )}
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
          <label class="label flex items-center gap-3 text-stone-2">
            <span>{t(ui.type, locale)}</span>
            <select class="field !min-w-[9.5rem] !py-1.5 !text-[13px] !normal-case !tracking-normal !font-normal text-ink" data-type-select>
              <option value="">{t(ui.allTypes, locale)}</option>
              {types.map(ty => <option value={ty}>{typeLabel(ty, locale)}</option>)}
            </select>
          </label>
          <label class="label flex items-center gap-3 text-stone-2">
            <span>{t(ui.sortBy, locale)}</span>
            <select class="field !min-w-[10.5rem] !py-1.5 !text-[13px] !normal-case !tracking-normal !font-normal text-ink" data-sort-select>
              <option value="newest">{t(ui.sortNewest, locale)}</option>
              <option value="price-desc">{t(ui.sortPriceHigh, locale)}</option>
              <option value="price-asc">{t(ui.sortPriceLow, locale)}</option>
            </select>
          </label>
        </div>
      </div>

      <p class="mt-6 text-xs text-stone" data-count aria-live="polite">{countText(items.length)}</p>

      <div class="mt-8 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" data-grid data-stagger>
        {items.map((l, i) => <div data-reveal><ListingCard listing={l} locale={locale} index={i} eager={i < 3} headingLevel="h2" /></div>)}
      </div>

      <div class="py-24 text-center" data-empty hidden={items.length > 0}>
        <p class="display-md">{t(ui.noMatches, locale)}</p>
        <button type="button" class="link-label mt-8 text-ink" data-clear>{t(ui.clearFilters, locale)}</button>
      </div>
    </div>
  </section>
</Base>

<script>
  function init() {
    const root = document.querySelector<HTMLElement>('[data-properties]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cells = Array.from(grid.children) as HTMLElement[]; // each cell wraps one [data-listing]
    const cardOf = (cell: HTMLElement) => cell.querySelector<HTMLElement>('[data-listing]') ?? cell;
    const chips = Array.from(root.querySelectorAll<HTMLElement>('[data-cat]'));
    const typeSel = root.querySelector<HTMLSelectElement>('[data-type-select]')!;
    const sortSel = root.querySelector<HTMLSelectElement>('[data-sort-select]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
    const mode = root.dataset.mode;
    const MAX = Number.MAX_SAFE_INTEGER;
    let cat = root.dataset.category || '';
    let interacted = false; // after the first user change, re-sorted cells show immediately instead of waiting for the reveal observer

    const price = (c: HTMLElement) => Number(cardOf(c).dataset.price) || MAX;
    const idx = (c: HTMLElement) => Number(cardOf(c).dataset.index);
    const apply = () => {
      const type = typeSel.value, sort = sortSel.value;
      const list = cells.slice();
      if (sort === 'price-desc') list.sort((a, b) => (price(b) === MAX ? -1 : price(b)) - (price(a) === MAX ? -1 : price(a)));
      else if (sort === 'price-asc') list.sort((a, b) => price(a) - price(b));
      else list.sort((a, b) => idx(a) - idx(b));
      list.forEach(c => grid.appendChild(c));
      let n = 0;
      for (const cell of cells) {
        const c = cardOf(cell);
        const show = (!cat || c.dataset.category === cat) && (!type || c.dataset.type === type);
        cell.hidden = !show; if (show) { n++; if (interacted) cell.classList.add('is-visible'); }
      }
      const ar = root.dataset.countAr ? JSON.parse(root.dataset.countAr) as Record<string, string> : null;
      const pluralCat = ar ? new Intl.PluralRules('ar').select(n) : (n === 1 ? 'one' : 'other');
      countEl.textContent = ar ? (ar[pluralCat] ?? ar.other).replace('{n}', String(n)) : (n === 1 ? (root.dataset.countOne || '1') : (root.dataset.countMany || '{n}').replace('{n}', String(n)));
      emptyEl.hidden = n > 0;
    };
    const setCat = (c: string) => {
      cat = c;
      for (const ch of chips) {
        const on = (ch.dataset.cat || '') === c;
        if (ch.tagName === 'BUTTON') ch.setAttribute('aria-pressed', String(on));
        else if (on) ch.setAttribute('aria-current', 'true'); else ch.removeAttribute('aria-current');
      }
    };
    const syncUrl = () => {
      const u = new URL(location.href);
      if (cat) u.searchParams.set('category', cat); else u.searchParams.delete('category');
      history.replaceState(history.state, '', u); // keep Astro's router state intact
    };

    // Category chips: links to the static category pages in "all" mode; client-side buttons on kind pages.
    if (mode !== 'category') {
      const fromUrl = new URLSearchParams(location.search).get('category') || '';
      if (fromUrl && chips.some(ch => ch.dataset.cat === fromUrl)) setCat(fromUrl);
    }
    if (mode === 'kind') chips.forEach(ch => ch.addEventListener('click', () => { interacted = true; setCat(ch.dataset.cat || ''); syncUrl(); apply(); }));
    const onChange = () => { interacted = true; apply(); };
    typeSel.addEventListener('change', onChange);
    sortSel.addEventListener('change', onChange);
    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      interacted = true;
      typeSel.value = ''; sortSel.value = 'newest';
      if (mode !== 'category') { setCat(''); if (mode === 'kind') syncUrl(); }
      apply();
    });
    apply();
  }
  document.addEventListener('astro:page-load', init);
</script>
