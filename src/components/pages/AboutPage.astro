---
/* /about/ — "About us". Driven by src/data/about.json (content agent): story paragraphs, values, principals, stats.
   Defensive: empty story/values fall back to the house copy; team and stats render only what the JSON contains. */
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import site from '../../data/site.json';
import about from '../../data/about.json';
import { localePath, t, ui, waLink, type Locale } from '../../lib/i18n';
import { editorialImage, ordered, listings, imageAlt } from '../../lib/listings';
import { breadcrumbJsonLd, orgJsonLd } from '../../lib/seo';
interface Props { locale: Locale }
const { locale } = Astro.props;
const path = localePath(locale, '/about/');
const wa = waLink(site.whatsapp.wa, t(ui.formGreeting, locale));
const pool = ordered(listings).filter(l => l.images?.length);
const img1 = editorialImage(2, 1), img1L = pool[2 % Math.max(1, pool.length)];
const img2 = editorialImage(4, 3), img2L = pool[4 % Math.max(1, pool.length)];
const markets = site.markets[locale];

type L = { en: string; ar: string };
type About = {
  story?: { en: string[]; ar: string[] };
  values?: { title: L; text: L }[];
  team?: { name: L; role: L; licence?: string | null; photo?: string | null }[];
  stats?: { label: L; value: string }[];
};
const data = about as About;
const storyAll = ((data.story?.[locale] ?? data.story?.en) ?? []).map(s => (s || '').trim()).filter(Boolean);
const statement = storyAll[0] || t(ui.aboutStatementFallback, locale);
const story = storyAll.slice(1);
const fallbackValues = [
  { title: { en: 'A small portfolio, by design', ar: 'محفظة صغيرة، عن قصد' }, text: { en: 'We represent villas, penthouses, waterfront residences and off-market houses that rarely reach the portals. Each is chosen because we would stand behind it ourselves.', ar: 'نمثّل فللاً وبنتهاوس ومساكن واجهية وبيوتاً خارج السوق قلّما تصل إلى المنصات. نختار كل واحد منها لأننا مستعدون أن نقف خلفه بأنفسنا.' } },
  { title: { en: 'Principal-level handling', ar: 'تعامل على مستوى الشركاء' }, text: { en: 'You deal with a principal from the first call to the handover. No hand-offs, no call centre; one person who knows the house, the street and the seller.', ar: 'تتعامل مع أحد شركاء الدار من أول اتصال حتى التسليم. لا تحويل بين موظفين ولا مركز اتصال؛ شخص واحد يعرف البيت والشارع والبائع.' } },
  { title: { en: 'Discretion', ar: 'التحفّظ' }, text: { en: 'Nothing is shared without consent. Some of our best work never appears on this site.', ar: 'لا يُشارك شيء دون إذن. بعض أفضل أعمالنا لا يظهر على هذا الموقع أبداً.' } },
];
const values = (data.values ?? []).filter(v => v?.title && v?.text);
const valueItems = values.length ? values : fallbackValues;
const team = (data.team ?? []).filter(m => m?.name && (m.name.en || m.name.ar));
const stats = (data.stats ?? []).filter(s => s?.label && s?.value).map(s => ({ ...s }));
// Numbers that describe the inventory are computed from listings.json so the About page can never go stale.
const live = listings.filter(l => l.status !== 'sold');
const jeddahDistricts = new Set(live.filter(l => l.location.city.en === 'Jeddah').map(l => l.location.district.en)).size;
const countries = new Set(live.map(l => l.location.countryCode)).size;
for (const s of stats) {
  if (/residences/i.test(s.label.en)) s.value = String(live.length);
  else if (/districts/i.test(s.label.en)) s.value = String(jeddahDistricts);
  else if (/countries/i.test(s.label.en)) s.value = String(countries);
}
/** Split "SAR 2.4bn+" into prefix / number / suffix for the count-up; non-numeric values render as plain text. */
const parseStat = (v: string) => {
  const m = String(v).trim().match(/^([^\d]*)([\d][\d,]*(?:\.\d+)?)(.*)$/);
  if (!m) return null;
  const num = m[2].replace(/,/g, '');
  if (!m[1] && !m[3] && /^(19|20)\d{2}$/.test(num)) return null; // a year ("Founded 2026") is not a quantity
  return { prefix: m[1], num, sep: m[2].includes(',') ? '1' : '0', suffix: m[3] };
};
const initials = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('');
const crumbs = [{ name: t(ui.home, locale), path: localePath(locale, '/') }, { name: t(ui.navAbout, locale), path }];
---
<Base title={`${t(ui.aboutMetaTitle, locale)} — ${locale === 'ar' ? site.nameAr : site.name}`} description={t(ui.aboutMetaDesc, locale)} locale={locale} path={path} image={img1?.src} jsonLd={[orgJsonLd(locale), breadcrumbJsonLd(crumbs)]}>
  <section class="section-tight pt-12 lg:pt-16">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7" data-reveal>
        <span class="rule"></span>
        <p class="label mt-6 text-stone-2">{t(ui.navAbout, locale)}</p>
        <h1 class="display-lg mt-4">{t(ui.aboutH1, locale)}</h1>
        <p class="statement mt-10 max-w-[34ch]">{statement}</p>
      </div>
      {img1 && img1L && (
        <div class="lg:col-span-5 lg:pt-16" data-reveal data-reveal-delay="1">
          <div class="parallax aspect-[4/5]"><img src={img1.src} alt={imageAlt(img1, img1L, locale)} loading="lazy" decoding="async" class="h-full w-full object-cover" /></div>
        </div>
      )}
    </div>
  </section>

  {story.length > 0 && (
    <section class="section-tight">
      <div class="wrap grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-3" data-reveal><span class="rule"></span><h2 class="label mt-6 text-stone-2">{t(ui.ourStory, locale)}</h2></div>
        <div class="prose-bona text-[15px] leading-relaxed text-ink/85 md:text-base lg:col-span-8 lg:col-start-5" data-reveal data-reveal-delay="1">
          {story.map(p => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  <section class="section-tight">
    <div class="wrap">
      <div data-reveal><span class="rule"></span><h2 class="label mt-6 text-stone-2">{t(ui.ourValues, locale)}</h2></div>
      <div class:list={['mt-10 grid gap-12 md:gap-10', valueItems.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3']} data-stagger>
        {valueItems.map(v => (
          <div data-reveal>
            <span class="rule"></span>
            <h3 class="display-md mt-6">{t(v.title, locale)}</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-stone-2">{t(v.text, locale)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {img2 && img2L && (
    <section class="section-tight pt-0">
      <div class="parallax bleed aspect-[16/9] md:aspect-[21/9]" data-reveal><img src={img2.src} alt={imageAlt(img2, img2L, locale)} loading="lazy" decoding="async" class="h-full w-full object-cover" /></div>
    </section>
  )}

  {team.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
          <div><span class="rule"></span><h2 class="display-lg mt-6">{t(ui.thePrincipals, locale)}</h2></div>
          <p class="text-sm text-stone-2">{t(ui.principalsIntro, locale)}</p>
        </div>
        <ul class:list={['mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2', team.length >= 3 && 'lg:grid-cols-3']} data-stagger>
          {team.map(m => {
            const name = t(m.name, locale) || m.name.en || m.name.ar;
            return (
              <li data-reveal>
                <div class="img-zoom aspect-[4/5] bg-ivory-2">
                  {m.photo
                    ? <img src={m.photo} alt={name} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                    : <div class="grid h-full w-full place-items-center font-display text-6xl text-champagne" aria-hidden="true">{initials(m.name.en || name)}</div>}
                </div>
                <h3 class="display-sm mt-5">{name}</h3>
                {m.role && <p class="mt-1 text-sm text-stone-2">{t(m.role, locale)}</p>}
                {m.licence && <p class="label mt-3 text-stone">{t(ui.falLicence, locale)} <span dir="ltr">{m.licence}</span></p>}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="on-dark bg-ink text-ivory">
    <div class="wrap section">
      {stats.length > 0 && (
        <div data-reveal>
          <span class="rule"></span>
          <h2 class="label mt-6 text-champagne">{t(ui.inNumbers, locale)}</h2>
          <dl class:list={['mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2', stats.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
            {stats.map(s => {
              const p = parseStat(s.value);
              return (
                <div>
                  <dd class="font-display text-[clamp(2.75rem,5vw,4.5rem)] leading-none" dir="ltr">
                    {p ? <span data-count-to={p.num} data-count-prefix={p.prefix} data-count-suffix={p.suffix} data-count-sep={p.sep}>{s.value}</span> : <span>{s.value}</span>}
                  </dd>
                  <dt class="mt-3 text-sm text-ivory/70">{t(s.label, locale)}</dt>
                </div>
              );
            })}
          </dl>
          <span class="rule-long mt-16"></span>
        </div>
      )}
      <div class:list={[stats.length > 0 ? 'mt-8' : '', 'flex flex-col gap-6 md:flex-row md:items-baseline md:justify-between']} data-reveal>
        <p class="label text-champagne">{t(ui.markets, locale)}</p>
        <ul class="flex flex-wrap gap-y-3">
          {markets.map((m, i) => (
            <li class="display-sm flex items-center text-ivory/85">
              {i > 0 && <span aria-hidden="true" class="mx-5 inline-block h-4 w-px bg-champagne"></span>}<span>{m}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow text-center" data-reveal>
      <span class="rule mx-auto"></span>
      <h2 class="display-lg mt-6">{t(ui.speakWithUs, locale)}</h2>
      <p class="mx-auto mt-6 max-w-[46ch] text-stone-2">{t(ui.aboutClosing, locale)}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={localePath(locale, '/contact/')} class="btn btn-ink">{t(ui.contactUs, locale)}</a>
        <a href={wa} target="_blank" rel="noopener" class="btn btn-outline"><Icon name="whatsapp" size={17} />{t(ui.chatOnWhatsApp, locale)}</a>
      </div>
    </div>
  </section>
</Base>
