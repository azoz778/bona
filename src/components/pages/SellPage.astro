---
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../EnquiryForm.astro';
import site from '../../data/site.json';
import { localePath, t, ui, type Locale } from '../../lib/i18n';
import { editorialImage, ordered, listings, imageAlt } from '../../lib/listings';
import { breadcrumbJsonLd } from '../../lib/seo';
interface Props { locale: Locale }
const { locale } = Astro.props;
const path = localePath(locale, '/sell/');
const pool = ordered(listings).filter(l => l.images?.length);
const img = editorialImage(3, 1), imgL = pool[3 % Math.max(1, pool.length)];
const c = {
  statement: { en: 'Selling a significant home is not a listing exercise. It is a matter of preparation, timing and the right introductions.',
               ar: 'بيع منزل مميّز ليس مجرد إعلان. إنه مسألة تجهيز وتوقيت وتعريفات صحيحة.' },
  para: { en: 'Bona markets your property discreetly, to our own buyers and our off-market network first, and brings you only qualified, verified interest.',
          ar: 'تسوّق بونا عقارك بتحفّظ، لمشترينا وشبكتنا خارج السوق أولاً، ولا تنقل إليك إلا اهتماماً جادّاً وموثّقاً.' },
  points: [
    { h: { en: 'Discreet marketing', ar: 'تسويق بتحفّظ' }, p: { en: 'No billboards and no mass portals unless you want them. Your home is shown to people, not to the internet.', ar: 'لا لوحات إعلانية ولا منصات جماهيرية إلا إن رغبت. يُعرض بيتك على أشخاص، لا على الإنترنت.' } },
    { h: { en: 'Qualified buyers', ar: 'مشترون جادّون' }, p: { en: 'We verify intent and means before any viewing. Your time is spent only on serious buyers.', ar: 'نتحقق من الجدّية والقدرة قبل أي معاينة. وقتك يُصرف على المشترين الجادّين فقط.' } },
    { h: { en: 'Off-market network', ar: 'شبكة خارج السوق' }, p: { en: 'Many of our sales never reach the market. Our buyers, family offices and partner brokers hear first.', ar: 'كثير من مبيعاتنا لا يصل إلى السوق أبداً. مشترونا ومكاتب العائلات والوسطاء الشركاء يعرفون أولاً.' } },
    { h: { en: 'One point of contact', ar: 'جهة تواصل واحدة' }, p: { en: 'One principal handles your sale from the first conversation to the handover of keys.', ar: 'شريك واحد من الدار يتولّى بيعك من أول محادثة حتى تسليم المفاتيح.' } },
  ],
  steps: [
    { h: { en: 'A conversation', ar: 'محادثة' }, p: { en: 'We visit, listen, and give you a clear, honest view of price and timing.', ar: 'نزورك ونستمع إليك، ونقدّم لك رؤية واضحة وصادقة عن السعر والتوقيت.' } },
    { h: { en: 'Preparation', ar: 'التجهيز' }, p: { en: 'Photography, floor plans and the advertising licence your listing needs, handled for you.', ar: 'التصوير والمخططات ورخصة الإعلان التي يحتاجها عرضك، نتولّاها عنك.' } },
    { h: { en: 'Introductions and completion', ar: 'التعريف والإتمام' }, p: { en: 'We show the house only to qualified buyers, negotiate on your behalf and manage the transfer through to the keys.', ar: 'نعرض البيت على المشترين الجادّين فقط، ونتفاوض نيابة عنك، وندير نقل الملكية حتى تسليم المفاتيح.' } },
  ],
  formIntro: { en: 'A few details are enough. We will come back to you personally on WhatsApp.', ar: 'تكفي بضعة تفاصيل. سنعود إليك شخصياً عبر واتساب.' },
};
const crumbs = [{ name: t(ui.home, locale), path: localePath(locale, '/') }, { name: t(ui.sellTitle, locale), path }];
---
<Base title={`${t(ui.sellMetaTitle, locale)} — ${locale === 'ar' ? site.nameAr : site.name}`} description={t(ui.sellMetaDesc, locale)} locale={locale} path={path} image={img?.src} jsonLd={breadcrumbJsonLd(crumbs)}>
  <section class="section-tight pt-12 lg:pt-16">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7" data-reveal>
        <span class="rule"></span>
        <h1 class="display-lg mt-6">{t(ui.sellTitle, locale)}</h1>
        <p class="statement mt-10 max-w-[30ch]">{t(c.statement, locale)}</p>
        <p class="mt-6 max-w-[52ch] text-stone-2">{t(c.para, locale)}</p>
        <a href="#seller-form" class="btn btn-ink mt-10">{t(ui.listYourProperty, locale)}</a>
      </div>
      {img && imgL && (
        <div class="lg:col-span-5 lg:pt-10" data-reveal data-reveal-delay="1">
          <div class="img-zoom aspect-[4/5]"><img src={img.src} alt={imageAlt(img, imgL, locale)} loading="lazy" decoding="async" class="h-full w-full object-cover" /></div>
        </div>
      )}
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {c.points.map((p, i) => (
        <div data-reveal data-reveal-delay={String(i % 4)}>
          <span class="rule"></span>
          <h2 class="display-sm mt-5">{t(p.h, locale)}</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-stone-2">{t(p.p, locale)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="on-dark bg-ink text-ivory">
    <div class="wrap section">
      <div data-reveal><span class="rule"></span><h2 class="display-lg mt-6">{t(ui.howItWorks, locale)}</h2></div>
      <ol class="mt-14 grid gap-12 md:grid-cols-3 md:gap-10">
        {c.steps.map((s, i) => (
          <li data-reveal data-reveal-delay={String(i)}>
            <p class="font-display text-5xl text-champagne">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="display-md mt-4">{t(s.h, locale)}</h3>
            <p class="mt-4 text-[15px] leading-relaxed text-ivory/70">{t(s.p, locale)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="seller-form">
    <div class="wrap-narrow">
      <div data-reveal>
        <span class="rule"></span>
        <h2 class="display-lg mt-6">{t(ui.sellerEnquiry, locale)}</h2>
        <p class="mt-4 max-w-[52ch] text-stone-2">{t(c.formIntro, locale)}</p>
      </div>
      <div class="mt-12"><EnquiryForm path={path} locale={locale} variant="sell" id="enquiry-sell" /></div>
    </div>
  </section>
</Base>
