---
import Base from '../../layouts/Base.astro';
import ListingCard from '../ListingCard.astro';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import site from '../../data/site.json';
import { localePath, t, ui, waLink, type Locale } from '../../lib/i18n';
import { heroListings, editorialImage, imageAlt, ordered, listings, featuredByKind, kindsPresent, kindSlug, kindLabelPlural, withTours, type Kind } from '../../lib/listings';
import { orgJsonLd } from '../../lib/seo';
interface Props { locale: Locale }
const { locale } = Astro.props;
const path = localePath(locale, '/');
const heroes = heroListings(3);
const heroImg = heroes[0]?.images?.[0];
const houses = featuredByKind('house', 6);
const apartments = featuredByKind('apartment', 6);
const present = kindsPresent();
const land = present.includes('land') ? featuredByKind('land', 3, 3) : [];
const buildings = present.includes('building') ? featuredByKind('building', 3, 3) : [];
const tours = withTours().length;
const markets = site.markets[locale];
const pool = ordered(listings).filter(l => l.images?.length);
const aboutImg = editorialImage(1, 2);
const aboutImgListing = pool[1 % Math.max(1, pool.length)];
const wa = waLink(site.whatsapp.wa, t(ui.formGreeting, locale));
const title = `${locale === 'ar' ? site.nameAr : site.name} — ${t(site.tagline, locale)}`;
const words = t(site.tagline, locale).split(/\s+/).filter(Boolean);
const strips: { kind: Kind; items: typeof land }[] = [{ kind: 'land', items: land }, { kind: 'building', items: buildings }].filter(s => s.items.length > 0);
---
<Base title={title} description={t(site.description, locale)} locale={locale} path={path} image={heroImg?.src} hero jsonLd={orgJsonLd(locale)}>
  <!-- Hero: full-bleed photograph(s) with a slow Ken Burns drift and an 8s crossfade between the top featured homes. -->
  <section class="hero relative flex min-h-[92svh] items-end bg-ink text-ivory">
    <div class="hero-slides absolute inset-0 overflow-hidden" data-hero-slides role="group" aria-roledescription="carousel" aria-label={t(ui.heroSlideshow, locale)}>
      {heroes.map((h, i) => {
        const img = h.images[0];
        return (
          <div class:list={['hero-slide', i === 0 && 'is-active']} data-slide aria-hidden={i === 0 ? undefined : 'true'}>
            <img src={i === 0 ? img.src : undefined} data-src={i === 0 ? undefined : img.src} srcset={i === 0 && img.thumb ? `${img.thumb} 400w, ${img.src} 1920w` : undefined} data-srcset={i !== 0 && img.thumb ? `${img.thumb} 400w, ${img.src} 1920w` : undefined} sizes="100vw" alt={imageAlt(img, h, locale)} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" class="h-full w-full object-cover" />
          </div>
        );
      })}
      <div class="absolute inset-0 z-[2] bg-linear-to-t from-ink/85 via-ink/20 to-ink/55"></div>
    </div>
    <div class="wrap relative z-[3] pb-20 pt-44 lg:pb-28">
      <p class="label text-champagne-2 hero-in" style="--i:0">{t(ui.privateRealEstate, locale)}</p>
      <h1 class="display-xl hero-words mt-6 max-w-[13ch]">
        {words.map((w, i) => <span class="hw" style={`--i:${i + 1}`}>{w}</span>)}
      </h1>
      <p class="hero-in mt-7 max-w-[50ch] text-[15px] leading-relaxed text-ivory/80 md:text-base" style={`--i:${words.length + 1}`}>{t(ui.heroSubline, locale)}</p>
      <div class="hero-in mt-10 flex flex-wrap gap-4" style={`--i:${words.length + 2}`}>
        <a href={localePath(locale, '/properties/')} class="btn btn-light">{t(ui.exploreProperties, locale)}</a>
        <a href={wa} target="_blank" rel="noopener" class="btn btn-outline-light"><Icon name="whatsapp" size={16} />{t(ui.privateEnquiry, locale)}</a>
      </div>
    </div>
    <a href="#houses" class="scroll-cue" aria-label={t(ui.scrollCue, locale)}><span class="label">{t(ui.scrollCue, locale)}</span><span class="scroll-cue-line" aria-hidden="true"></span></a>
  </section>

  <!-- Houses -->
  {houses.length > 0 && (
    <section class="section" id="houses">
      <div class="wrap">
        <SectionHead title={t(ui.housesTitle, locale)} intro={t(ui.housesIntro, locale)} link={{ href: localePath(locale, '/properties/houses/'), label: t(ui.viewAllHouses, locale) }} />
        <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-2" data-stagger>
          {houses.map((l, i) => <div data-reveal><ListingCard listing={l} locale={locale} index={i} ratio="3/2" /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- Markets: a slow marquee -->
  <section class="border-y border-ink/10">
    <div class="section-tight">
      <div class="wrap flex flex-col gap-6" data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <p class="label text-stone-2">{t(ui.markets, locale)}</p>
          <p class="text-sm text-stone-2">{t(ui.marketsIntro, locale)}</p>
        </div>
      </div>
      <div class="marquee mt-8" data-reveal>
        <ul class="marquee-track">
          {markets.map(m => <li class="display-md flex items-center"><span>{m}</span><span aria-hidden="true" class="mx-7 inline-block h-6 w-px bg-champagne md:mx-10"></span></li>)}
        </ul>
        <ul class="marquee-track" aria-hidden="true">
          {markets.map(m => <li class="display-md flex items-center"><span>{m}</span><span aria-hidden="true" class="mx-7 inline-block h-6 w-px bg-champagne md:mx-10"></span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Apartments -->
  {apartments.length > 0 && (
    <section class="section" id="apartments">
      <div class="wrap">
        <SectionHead title={t(ui.apartmentsTitle, locale)} intro={t(ui.apartmentsIntro, locale)} link={{ href: localePath(locale, '/properties/apartments/'), label: t(ui.viewAllApartments, locale) }} />
        <div class:list={['mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2', apartments.length >= 3 && 'lg:grid-cols-3']} data-stagger>
          {apartments.map((l, i) => <div data-reveal><ListingCard listing={l} locale={locale} index={i} ratio={apartments.length >= 3 ? '4/3' : '3/2'} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- Land / Buildings strips: only when such listings exist -->
  {strips.map(s => (
    <section class="border-t border-ink/10">
      <div class="wrap section-tight">
        <SectionHead title={t(kindLabelPlural[s.kind], locale)} intro={s.kind === 'land' ? t(ui.landIntro, locale) : t(ui.buildingsPageIntro, locale)} link={{ href: localePath(locale, `/properties/${kindSlug[s.kind]}/`), label: s.kind === 'land' ? t(ui.viewAllLand, locale) : t(kindLabelPlural[s.kind], locale) }} />
        <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {s.items.map((l, i) => <div data-reveal><ListingCard listing={l} locale={locale} index={i} /></div>)}
        </div>
      </div>
    </section>
  ))}

  <!-- About us -->
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6 lg:self-center" data-reveal>
        <span class="rule"></span>
        <p class="label mt-6 text-stone-2">{t(ui.navAbout, locale)}</p>
        <p class="statement mt-6">{t(ui.homeAboutStatement, locale)}</p>
        <div class="mt-10 flex flex-wrap items-center gap-8">
          <a href={localePath(locale, '/about/')} class="link-label inline-block text-ink">{t(ui.aboutBona, locale)}</a>
          {tours > 0 && <a href={localePath(locale, '/tours/')} class="link-label inline-flex items-center gap-2 text-ink"><Icon name="cube" size={14} />{t(ui.navTours, locale)}</a>}
        </div>
      </div>
      {aboutImg && aboutImgListing && (
        <div class="lg:col-span-5 lg:col-start-8" data-reveal data-reveal-delay="1">
          <div class="parallax aspect-[4/5]">
            <img src={aboutImg.src} alt={imageAlt(aboutImg, aboutImgListing, locale)} loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Sell with Bona -->
  <section class="on-dark bg-ink text-ivory">
    <div class="wrap section grid gap-10 lg:grid-cols-12 lg:items-center" data-reveal>
      <div class="lg:col-span-7">
        <span class="rule"></span>
        <h2 class="display-lg mt-6">{t(ui.sellWithBona, locale)}</h2>
        <p class="mt-6 max-w-[52ch] text-ivory/75">{t(ui.sellBandText, locale)}</p>
      </div>
      <div class="lg:col-span-5 lg:flex lg:justify-end">
        <a href={localePath(locale, '/sell/')} class="btn btn-champagne">{t(ui.listYourProperty, locale)}</a>
      </div>
    </div>
  </section>

  <!-- Instagram -->
  <section class="bg-ivory-2">
    <div class="wrap section-tight flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between" data-reveal>
      <div>
        <p class="label text-stone-2">{t(ui.instagram, locale)}</p>
        <a href={site.instagram.url} target="_blank" rel="noopener" class="display-md mt-3 inline-flex items-center gap-4 hover:text-stone-2 transition-colors">
          <Icon name="instagram" size={26} class="text-champagne" /><span dir="ltr">@{site.instagram.handle}</span>
        </a>
      </div>
      <p class="max-w-[40ch] text-sm text-stone-2">{t(ui.instagramBandText, locale)}</p>
    </div>
  </section>

  <!-- Contact -->
  <section class="section">
    <div class="wrap-narrow text-center" data-reveal>
      <span class="rule mx-auto"></span>
      <h2 class="display-lg mt-6">{t(ui.speakWithUs, locale)}</h2>
      <p class="mx-auto mt-6 max-w-[48ch] text-stone-2">{t(ui.contactBandText, locale)}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={wa} target="_blank" rel="noopener" class="btn btn-ink"><Icon name="whatsapp" size={17} />{t(ui.chatOnWhatsApp, locale)}</a>
        <a href={`tel:${site.phone.e164}`} class="btn btn-outline" dir="ltr">{site.phone.display}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  /* Hero slideshow: crossfade every 8s between the featured heroes. Cleared before every navigation. */
  let timer = 0, fade = 0;
  function init() {
    window.clearInterval(timer); window.clearTimeout(fade);
    const root = document.querySelector<HTMLElement>('[data-hero-slides]');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    // Deferred slides: assign src ~5s before they are shown so the LCP image never competes with them.
    const hydrate = (s?: HTMLElement) => { const im = s?.querySelector<HTMLImageElement>('img[data-src]'); if (!im) return; if (im.dataset.srcset) im.srcset = im.dataset.srcset; im.src = im.dataset.src!; im.removeAttribute('data-src'); im.removeAttribute('data-srcset'); };
    fade = window.setTimeout(() => hydrate(slides[1]), 3000);
    timer = window.setInterval(() => {
      if (document.hidden) return;
      const prev = slides[i]; i = (i + 1) % slides.length; const next = slides[i];
      hydrate(next); hydrate(slides[(i + 1) % slides.length]);
      prev.classList.replace('is-active', 'was-active'); prev.setAttribute('aria-hidden', 'true');
      next.classList.add('is-active'); next.removeAttribute('aria-hidden');
      fade = window.setTimeout(() => prev.classList.remove('was-active'), 1800);
    }, 8000);
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { window.clearInterval(timer); window.clearTimeout(fade); });
</script>
