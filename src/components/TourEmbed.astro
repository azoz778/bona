---
/* Matterport 3D tour: a facade (poster + play + "3D" badge) that swaps in the iframe on click, so the heavy
   embed never loads unless asked for. Data-driven from listing.virtualTourUrl. */
import Icon from './Icon.astro';
import { t, ui, fill, type Locale } from '../lib/i18n';
import { localeTitle, imageAlt, matterportId, tourEmbedUrl, type Listing } from '../lib/listings';
interface Props { listing: Listing; locale: Locale; class?: string }
const { listing: l, locale, class: cls = '' } = Astro.props;
const id = matterportId(l.virtualTourUrl);
const poster = l.images?.[0];
const title = localeTitle(l, locale);
---
{id && (
  <section id="tour" class:list={['tour scroll-mt-28', cls]} data-tour data-src={tourEmbedUrl(id)} data-title={fill(t(ui.tourFrameTitle, locale), { title })} aria-labelledby={`tour-${l.id}`}>
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 id={`tour-${l.id}`} class="label text-stone-2">{t(ui.tour3dTitle, locale)}</h2>
        <p class="mt-3 max-w-[52ch] text-[15px] leading-relaxed text-stone-2">{t(ui.tour3dIntro, locale)}</p>
      </div>
      <a href={l.virtualTourUrl} target="_blank" rel="noopener" class="link-label shrink-0 self-start text-ink md:self-auto"><span class="inline-flex items-center gap-2">{t(ui.openInMatterport, locale)}<Icon name="external" size={14} /></span></a>
    </div>
    <div class="tour-frame mt-6" data-tour-frame>
      <button type="button" class="tour-facade" data-tour-play aria-label={t(ui.playTour, locale)}>
        {poster && <img src={poster.src} alt={imageAlt(poster, l, locale)} loading="lazy" decoding="async" class="h-full w-full object-cover" />}
        <span class="tour-shade" aria-hidden="true"></span>
        <span class="badge badge-3d absolute start-4 top-4" aria-hidden="true"><Icon name="cube" size={12} />3D</span>
        <span class="tour-play" aria-hidden="true"><Icon name="play" size={26} /></span>
        <span class="tour-caption label" aria-hidden="true">{t(ui.playTour, locale)}</span>
      </button>
    </div>
  </section>
)}

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-tour]:not([data-ready])').forEach(root => {
      root.dataset.ready = '1';
      const frame = root.querySelector<HTMLElement>('[data-tour-frame]');
      const play = root.querySelector<HTMLButtonElement>('[data-tour-play]');
      if (!frame || !play) return;
      play.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = root.dataset.src || '';
        iframe.title = root.dataset.title || '3D tour';
        iframe.setAttribute('allow', 'xr-spatial-tracking; fullscreen; vr');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('loading', 'lazy');
        iframe.setAttribute('referrerpolicy', 'no-referrer-when-downgrade');
        iframe.className = 'absolute inset-0 h-full w-full border-0';
        frame.classList.add('is-live');
        play.replaceWith(iframe);
        iframe.focus();
      }, { once: true });
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
