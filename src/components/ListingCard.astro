---
import { localePath, formatPrice, formatNumber, t, ui, type Locale } from '../lib/i18n';
import { localeTitle, imageAlt, sortablePrice, typeLabel, type Listing } from '../lib/listings';
interface Props { listing: Listing; locale: Locale; index?: number; ratio?: '4/3' | '3/2'; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { listing: l, locale, index = 0, ratio = '4/3', eager = false, headingLevel: H = 'h3' } = Astro.props;
const img = l.images?.[0];
const href = localePath(locale, `/properties/${l.slug}/`);
const title = localeTitle(l, locale);
const specs: string[] = [];
if (l.specs?.beds) specs.push(`${l.specs.beds} ${t(ui.bedsShort, locale)}`);
if (l.specs?.baths) specs.push(`${l.specs.baths} ${t(ui.bathsShort, locale)}`);
if (l.specs?.areaSqm) specs.push(`${formatNumber(l.specs.areaSqm)} ${t(ui.sqm, locale)}`);
const badge = l.status === 'sold' ? t(ui.sold, locale) : l.status === 'reserved' ? t(ui.reserved, locale) : null;
---
<article class="group" data-listing data-category={l.category} data-type={(l.type || '').toLowerCase()} data-price={sortablePrice(l)} data-index={index} data-status={l.status}>
  <a href={href} class="block">
    <div class:list={['img-zoom relative', ratio === '3/2' ? 'aspect-[3/2]' : 'aspect-[4/3]']}>
      {img && (
        <img src={img.thumb ?? img.src} alt={imageAlt(img, l, locale)} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined}
             class:list={['h-full w-full object-cover', l.status === 'sold' && 'opacity-80 saturate-50']} />
      )}
      {badge && <span class="badge absolute start-3 top-3">{badge}</span>}
    </div>
    <div class="pt-5">
      <p class="label text-stone">{typeLabel(l.type, locale)}</p>
      <H class="display-sm mt-2 leading-snug">{title}</H>
      <p class="mt-1 text-[13px] text-stone-2">{t(l.location.district, locale)} · {t(l.location.city, locale)}</p>
      <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="text-sm font-semibold">{formatPrice(l.price, locale)}</p>
        {specs.length > 0 && <p class="text-xs text-stone-2">{specs.join('  ·  ')}</p>}
      </div>
    </div>
  </a>
</article>
