---
/* <Head> — owned by the seo-social agent.
   Props API (stable): title, description, locale, path, image?, noindex?, jsonLd? (object | object[])
   Emits: charset/viewport, title (+ brand suffix), description, canonical, hreflang en/ar/x-default,
   robots, theme-color, favicons/manifest, Open Graph + Twitter, JSON-LD @graph (org + website once,
   plus whatever the page passes), preconnects, the tag configuration (window.BONA_TAGS / BONA_API), the inline
   first-party attribution script and the consent-gated tag loader (src/scripts/*.js). Nothing from Google, Meta,
   Snap or TikTok is requested until the visitor accepts in the consent banner — and a tag whose id is null in
   site.json → analytics is inert whatever the visitor chooses. */
import site from '../../data/site.json';
import type { Locale } from '../../lib/i18n';
import privacy from '../../data/privacy.json';
import { absoluteUrl, alternates, defaultOgImage, ogLocale, orgJsonLd, pageTitle, websiteJsonLd, compact, personJsonLd, webPageJsonLd, pageKindFromPath } from '../../lib/seo';
import attributionSrc from '../../scripts/attribution.js?raw';
import tagsSrc from '../../scripts/tags.js?raw';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, locale, path, image, noindex = false, jsonLd } = Astro.props;
const ar = locale === 'ar';
const brand = ar ? site.nameAr : site.name;
const fullTitle = pageTitle(title, locale);
const desc = (description ?? '').trim().replace(/\s+/g, ' ');
const canonical = absoluteUrl(path);
const alt = alternates(path);
const ogImage = absoluteUrl(image || defaultOgImage);
const isDefaultImage = !image || image === defaultOgImage;
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// ---- JSON-LD: one @graph — org + website + founder injected once, then the page's nodes, then an automatic
//      WebPage-family node (WebPage / AboutPage / ContactPage / CollectionPage / ItemPage) unless the page supplied
//      one with the same @id (<canonical>#webpage). Everything is deduped by @id; first occurrence wins. ----
type Node = Record<string, unknown>;
const pageNodes: Node[] = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).filter(Boolean) as Node[];
const baseNodes: Node[] = [orgJsonLd(locale) as Node, websiteJsonLd(locale) as Node, personJsonLd(locale) as Node];
const seen = new Set<string>();
const graph: Node[] = [];
const push = (raw: Node) => {
  const node = compact({ ...raw }) as Node;
  delete node['@context'];
  const id = typeof node['@id'] === 'string' ? (node['@id'] as string) : undefined;
  if (id) {
    if (seen.has(id)) return;
    seen.add(id);
  }
  graph.push(node);
};
for (const raw of [...baseNodes, ...pageNodes]) push(raw);
// Listing pages: og:type article-ish + published time
const listingNode = graph.find((n) => n['@type'] === 'RealEstateListing');
const breadcrumbNode = graph.find((n) => n['@type'] === 'BreadcrumbList');
const strippedPath = (path || '/').replace(/^\/ar(?=\/|$)/, '') || '/';
const isPrivacy = strippedPath === '/privacy/';
if (!noindex) {
  push(webPageJsonLd({
    locale,
    path,
    title: fullTitle,
    description: desc,
    type: pageKindFromPath(path),
    image: ogImage,
    mainEntityId: listingNode && typeof listingNode['@id'] === 'string' ? (listingNode['@id'] as string) : undefined,
    breadcrumbId: breadcrumbNode && typeof breadcrumbNode['@id'] === 'string' ? (breadcrumbNode['@id'] as string) : undefined,
    datePublished: isPrivacy ? privacy.updated : undefined,
    dateModified: isPrivacy ? privacy.updated : undefined,
  }) as Node);
}
const ogType = listingNode ? 'article' : 'website';
const publishedTime = listingNode && typeof listingNode.datePosted === 'string' ? listingNode.datePosted : undefined;
const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

// ---- Tags. Ids live in site.json → analytics; every one is optional. They are only ever handed to the browser as
//      configuration: src/scripts/tags.js injects the vendor loaders after consent (see Consent.astro). ----
const analytics = site.analytics as { ga4?: string | null; metaPixel?: string | null; snapPixel?: string | null; tiktokPixel?: string | null; gscVerification?: string | null };
const tags = {
  ga4: analytics.ga4 || null,
  metaPixel: analytics.metaPixel || null,
  snapPixel: analytics.snapPixel || null,
  tiktokPixel: analytics.tiktokPixel || null,
};
const gsc = analytics.gscVerification || null;
const apiBase = ((site as { concierge?: { apiBase?: string } }).concierge?.apiBase || '').replace(/\/+$/, '');
// `<` is escaped so a value can never close the script element.
const tagConfig = `window.BONA_TAGS=${JSON.stringify(tags)};window.BONA_API=${JSON.stringify(apiBase)};`.replace(/</g, '\\u003c');

// ---- Content Security Policy (GitHub Pages sends no headers, so it travels as a <meta>; frame-ancestors cannot be
//      set that way and is left out). Everything the site talks to, and nothing else: the concierge API, the vendor
//      tags (Google, Meta, Snap, TikTok — which only load after consent), Retell/LiveKit for the browser call, and
//      Matterport, OpenStreetMap and the Google Maps office embed as frames. Localhost API origins are allowed only
//      in dev builds or with BONA_CSP_LOCAL_API=1 (QA against a local API through the ?concierge_api= override, see
//      docs/qa/concierge/README.md). ----
const siteOrigin = new URL(site.url).origin;
const localApi = import.meta.env.DEV || process.env.BONA_CSP_LOCAL_API === '1';
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://sc-static.net https://analytics.tiktok.com",
  ["connect-src 'self'", apiBase, siteOrigin,
    'https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com',
    'https://www.facebook.com https://tr.snapchat.com https://analytics.tiktok.com',
    'https://*.retellai.com wss://*.retellai.com https://*.livekit.cloud wss://*.livekit.cloud',
    localApi ? 'http://localhost:* http://127.0.0.1:*' : ''].filter(Boolean).join(' '),
  "img-src 'self' data: https:",
  "media-src 'self' https: blob:",
  'frame-src https://my.matterport.com https://www.openstreetmap.org https://www.google.com',
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self' data:",
  "worker-src 'self' blob:",
].join('; ');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta http-equiv="Content-Security-Policy" content={csp} />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="robots" content={robots} />
<meta name="format-detection" content="telephone=no" />
<meta name="theme-color" content="#f5f1ea" />
<meta name="color-scheme" content="light" />
<meta name="author" content={site.legalName} />
<meta name="generator" content={Astro.generator} />
{gsc && <meta name="google-site-verification" content={gsc} />}
<meta name="geo.region" content="SA-02" />
<meta name="geo.placename" content={ar ? site.address.ar.city : site.address.en.city} />
<meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
<meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />

<link rel="canonical" href={canonical} />
{!noindex && (
  <>
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="ar" href={alt.ar} />
    <link rel="alternate" hreflang="x-default" href={alt.xDefault} />
  </>
)}
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preconnect" href="https://tk-storage.azoz.uk" crossorigin />
<link rel="dns-prefetch" href="https://tk-storage.azoz.uk" />
{ar ? (
  <>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/plex-arabic-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/amiri-700.woff2" crossorigin />
  </>
) : (
  <>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/montserrat-400.woff2" crossorigin />
  </>
)}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={brand} />
<meta property="og:locale" content={ogLocale(locale)} />
<meta property="og:locale:alternate" content={ogLocale(ar ? 'en' : 'ar')} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
{isDefaultImage && <meta property="og:image:type" content="image/png" />}
<meta property="og:image:alt" content={isDefaultImage ? (ar ? 'بونا — عقارات فاخرة خاصة، جدة' : 'Bona — private luxury real estate, Jeddah') : fullTitle} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{listingNode && <meta property="article:section" content={ar ? 'العقارات' : 'Properties'} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={isDefaultImage ? (ar ? 'بونا — عقارات فاخرة خاصة، جدة' : 'Bona — private luxury real estate, Jeddah') : fullTitle} />

<script type="application/ld+json" set:html={jsonLdText} />

{/* Tag configuration, first-party attribution, consent-gated tag loader. Inline so they run before anything else on
    every page, including the very first paint; each script binds once (window.__bona* guards) and re-runs its
    per-page work on astro:page-load. */}
<script is:inline set:html={tagConfig} />
<script is:inline set:html={attributionSrc} />
<script is:inline set:html={tagsSrc} />
