---
/* Save the private enquiry, acknowledge acceptance and offer an explicit WhatsApp continuation.
   Failed or timed-out requests retain the fields and retry with the same id. */
import site from '../data/site.json';
import { t, ui, localePath, type Locale } from '../lib/i18n';
import { typeLabel } from '../lib/listings';
interface Props {
  locale: Locale;
  variant?: 'contact' | 'sell' | 'listing';
  /** Listing context for the 'listing' variant. */
  listing?: { id: string; title: string; path: string };
  class?: string;
  id?: string;
  /** Current page path (for lead attribution when there is no listing). */
  path?: string;
}
const { locale, variant = 'contact', listing, class: cls = '', id = `enquiry-${variant}`, path } = Astro.props;
const types = ['villa', 'apartment', 'penthouse', 'mansion', 'land', 'building', 'duplex'];
const labels = {
  greeting: t(ui.formGreeting, locale), name: t(ui.labelName, locale), phone: t(ui.labelPhone, locale), interest: t(ui.labelInterest, locale),
  type: t(ui.labelType, locale), budget: t(ui.labelBudget, locale), location: t(ui.labelLocation, locale), ref: t(ui.labelRef, locale),
  message: t(ui.labelMessage, locale), sentFrom: t(ui.sentFrom, locale),
  errName: t(ui.formErrName, locale), errPhone: t(ui.formErrPhone, locale),
  send: locale === 'ar' ? 'إرسال الاستفسار' : 'Send enquiry',
  sending: locale === 'ar' ? 'جارٍ إرسال الاستفسار…' : 'Sending your enquiry…',
  accepted: locale === 'ar' ? 'تم حفظ استفسارك لدى بونا. يمكنك أيضاً متابعة الحديث عبر واتساب.' : 'Your enquiry is saved with Bona. You can also continue on WhatsApp.',
  failed: locale === 'ar' ? 'تعذّر تأكيد حفظ استفسارك. ما زالت بياناتك هنا؛ أعد المحاولة أو أرسلها عبر واتساب.' : 'We could not confirm that your enquiry was saved. Your details are still here. Retry or send them on WhatsApp.',
  rateLimited: locale === 'ar' ? 'يرجى الانتظار قليلاً ثم إعادة المحاولة، أو التواصل عبر واتساب.' : 'Please wait a moment before retrying, or continue on WhatsApp.',
  retry: locale === 'ar' ? 'إعادة المحاولة' : 'Retry enquiry',
  preview: locale === 'ar' ? 'هذه معاينة محلية. لم يتم إرسال أي استفسار.' : 'This is a local preview. No enquiry has been sent.',
};
const pageUrl = new URL(listing?.path ?? path ?? '/', site.url).href;
---
<form class:list={['enquiry', cls]} id={id} data-enquiry data-wa={site.whatsapp.wa} data-labels={JSON.stringify(labels)} data-page={pageUrl} data-variant={variant} data-listing={listing?.id} novalidate>
  {listing && <input type="hidden" name="ref" value={`${listing.title} (${listing.id})`} />}
  <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
    <div>
      <label class="field-label" for={`${id}-name`}>{t(ui.formName, locale)}</label>
      <input class="field" id={`${id}-name`} name="name" type="text" autocomplete="name" required aria-describedby={`${id}-name-error`} />
      <p class="field-error" id={`${id}-name-error`} data-error-for="name" aria-live="polite" hidden></p>
    </div>
    <div>
      <label class="field-label" for={`${id}-phone`}>{t(ui.formPhone, locale)}</label>
      <input class="field" id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder={locale === 'ar' ? '+966 5٠ ٠٠٠ ٠٠٠٠' : '+966 5x xxx xxxx'} required aria-describedby={`${id}-phone-error`} class:list={[locale === 'ar' && 'text-end']} />
      <p class="field-error" id={`${id}-phone-error`} data-error-for="phone" aria-live="polite" hidden></p>
    </div>

    {variant === 'contact' && (
      <div>
        <label class="field-label" for={`${id}-interest`}>{t(ui.formInterest, locale)}</label>
        <select class="field" id={`${id}-interest`} name="interest">
          <option value={t(ui.interestBuy, locale)}>{t(ui.interestBuy, locale)}</option>
          <option value={t(ui.interestSell, locale)}>{t(ui.interestSell, locale)}</option>
          <option value={t(ui.interestRent, locale)}>{t(ui.interestRent, locale)}</option>
        </select>
      </div>
    )}
    {variant !== 'listing' && (
      <div>
        <label class="field-label" for={`${id}-type`}>{t(ui.formPropertyType, locale)}</label>
        <select class="field" id={`${id}-type`} name="type">
          <option value="">{t(ui.allTypes, locale)}</option>
          {types.map(ty => <option value={typeLabel(ty, locale)}>{typeLabel(ty, locale)}</option>)}
        </select>
      </div>
    )}
    {variant === 'contact' && (
      <div class="sm:col-span-2">
        <label class="field-label" for={`${id}-budget`}>{t(ui.formBudget, locale)} <span class="normal-case tracking-normal text-stone">({t(ui.formOptional, locale)})</span></label>
        <input class="field" id={`${id}-budget`} name="budget" type="text" />
      </div>
    )}
    {variant === 'sell' && (
      <div class="sm:col-span-2">
        <label class="field-label" for={`${id}-location`}>{t(ui.formLocation, locale)}</label>
        <input class="field" id={`${id}-location`} name="location" type="text" autocomplete="off" />
      </div>
    )}
    <div class="sm:col-span-2">
      <label class="field-label" for={`${id}-message`}>{t(ui.formMessage, locale)} <span class="normal-case tracking-normal text-stone">({t(ui.formOptional, locale)})</span></label>
      <textarea class="field min-h-[6rem] resize-y" id={`${id}-message`} name="message" rows="3"></textarea>
    </div>
  </div>
  <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <button type="submit" class="btn btn-ink" data-submit><span data-submit-label>{labels.send}</span></button>
    <p class="text-xs text-stone">{locale === "ar" ? "تُرسل بياناتك إلى بونا للرد على استفسارك." : "Your details go to Bona to answer your enquiry."} <a href={localePath(locale, '/privacy/')} class="link text-stone-2 hover:text-ink">{t(ui.navPrivacy, locale)}</a></p>
  </div>
  <div class="mt-8 border border-champagne/60 bg-ivory-2 p-6" data-thanks hidden>
    <p class="text-sm" data-enquiry-status role="status" aria-live="polite" tabindex="-1"></p>
    <button type="button" class="btn btn-outline mt-5" data-thanks-link data-cta="form_whatsapp">{t(ui.formOpenWhatsApp, locale)}</button>
  </div>
</form>

<script>
  import { createEnquirySubmitter } from '../lib/enquiry-client.mjs';
  const LISTING_RE = /^BONA-W?\d{3}$/;
  type Attr = { anon_id?: string; session?: { id?: string; ref?: string } | null; first?: unknown; last?: unknown; fbp?: unknown; fbc?: unknown; ga?: unknown; scid?: unknown; ttp?: unknown };
  type Hooks = Window & { bonaMeasurementAllowed?: () => boolean; BONA_API?: string; BONA_ATTR?: Attr; bonaEventId?: () => string; bonaTrack?: (e: string, p?: Record<string, unknown>, o?: { eventId?: string }) => unknown };
  const w = window as Hooks;

  function consentFlags() {
    try { const c = JSON.parse(localStorage.getItem('bona_consent') || 'null'); return { analytics: c?.analytics === true, ads: c?.ads === true }; } catch { return { analytics: false, ads: false }; }
  }
  function initForm(form: HTMLFormElement) {
    if (form.dataset.ready) return;
    form.dataset.ready = '1';
    const labels = JSON.parse(form.dataset.labels || '{}') as Record<string, string>;
    const wa = form.dataset.wa || '';
    const page = form.dataset.page || '';
    const thanks = form.querySelector<HTMLElement>('[data-thanks]');
    const thanksLink = form.querySelector<HTMLButtonElement>('[data-thanks-link]');
    const status = form.querySelector<HTMLElement>('[data-enquiry-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const submit = createEnquirySubmitter({ api: w.BONA_API || '', eventId: () => w.bonaEventId?.() || `${Date.now().toString(36)}-${Math.random().toString(16).slice(2, 10)}` });
    let whatsappUrl = '';
    let busy = false;
    // A button holds no personal URL in the DOM for automatic outbound-link analytics to collect.
    thanksLink?.addEventListener('click', () => {
      if (!whatsappUrl || (w.bonaMeasurementAllowed && !w.bonaMeasurementAllowed())) return;
      w.bonaTrack?.('whatsapp_click', { cta: 'form_whatsapp' });
      const currentName = field('name')?.value.trim() || '';
      const currentPhone = (field('phone')?.value || '').replace(/[٠-٩]/g,d=>String(d.charCodeAt(0)-0x660)).replace(/[۰-۹]/g,d=>String(d.charCodeAt(0)-0x6F0)).replace(/[\s\-().]/g,'');
      setError('name', currentName.length < 2 ? labels.errName : '');
      setError('phone', !/^\+?\d{7,15}$/.test(currentPhone) ? labels.errPhone : '');
      if(currentName.length < 2 || !/^\+?\d{7,15}$/.test(currentPhone)) { (form.querySelector('.is-invalid') as HTMLElement | null)?.focus(); return; }
      window.open(buildWhatsappUrl(), '_blank', 'noopener,noreferrer');
    });
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
    const setError = (n: string, msg: string) => {
      const el = field(n); const p = form.querySelector<HTMLElement>(`[data-error-for="${n}"]`);
      if (el) { el.classList.toggle('is-invalid', !!msg); if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); }
      if (p) { p.textContent = msg; p.hidden = !msg; }
    };
    function buildWhatsappUrl() {
      const lines = [labels.greeting, ''];
      const ref = field('ref')?.value; if(ref) lines.push(`${labels.ref}: ${ref}`);
      for(const [key,label] of [['name',labels.name],['phone',labels.phone],['interest',labels.interest],['type',labels.type],['budget',labels.budget],['location',labels.location]]) {
        const value=field(key)?.value.trim();if(value)lines.push(`${label}: ${value}`);
      }
      const message=field('message')?.value.trim();if(message)lines.push('',`${labels.message}:`,message);
      lines.push('',`${labels.sentFrom} ${page}`);
      const listing=form.dataset.listing || document.body.dataset.listing || '';
      const refCode=w.BONA_ATTR?.session?.ref;if(refCode)lines.push(`Ref ${LISTING_RE.test(listing)?listing:'BONA'} · ${refCode}`);
      return `https://wa.me/${wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    }
    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (busy) return;
      const name = field('name')?.value.trim() || '';
      // Normalise Arabic-Indic (٠-٩) and Persian (۰-۹) digits so AR keyboards validate.
      const phoneRaw = (field('phone')?.value.trim() || '').replace(/[٠-٩]/g, d => String(d.charCodeAt(0) - 0x660)).replace(/[۰-۹]/g, d => String(d.charCodeAt(0) - 0x6F0));
      const phone = phoneRaw.replace(/[\s\-().]/g, '');
      let ok = true;
      setError('name', ''); setError('phone', '');
      if (name.length < 2) { setError('name', labels.errName); ok = false; }
      if (!/^\+?\d{7,15}$/.test(phone)) { setError('phone', labels.errPhone); ok = false; }
      if (!ok) { (form.querySelector('.is-invalid') as HTMLElement | null)?.focus(); return; }

      const lines: string[] = [labels.greeting, ''];
      const ref = field('ref')?.value;
      if (ref) lines.push(`${labels.ref}: ${ref}`);
      lines.push(`${labels.name}: ${name}`, `${labels.phone}: ${phoneRaw}`);
      const pairs: [string, string][] = [['interest', labels.interest], ['type', labels.type], ['budget', labels.budget], ['location', labels.location]];
      for (const [n, l] of pairs) { const v = field(n)?.value.trim(); if (v) lines.push(`${l}: ${v}`); }
      const msg = field('message')?.value.trim();
      if (msg) lines.push('', `${labels.message}:`, msg);
      lines.push('', `${labels.sentFrom} ${page}`);

      // Ref line (contract C2) — last line of the message, so the API can match the WhatsApp conversation.
      const listingRaw = form.dataset.listing || document.body.dataset.listing || '';
      const listing = LISTING_RE.test(listingRaw) ? listingRaw : null;
      const attr = w.BONA_ATTR;
      const sessionRef = attr?.session?.ref;
      if (sessionRef) lines.push(`Ref ${listing || 'BONA'} \u00B7 ${sessionRef}`);

      const value = (n: string) => field(n)?.value.trim() || null;
      whatsappUrl = `https://wa.me/${wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      if (thanks) thanks.hidden = false;
      if (w.bonaMeasurementAllowed && !w.bonaMeasurementAllowed()) {
        if (status) status.textContent = labels.preview;
        if (thanksLink) thanksLink.hidden = true;
        return;
      }
      if (thanksLink) thanksLink.hidden = false;
      busy = true;
      const draftFields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input,textarea,select')).filter(el => !el.disabled);
      draftFields.forEach(el => { el.disabled = true; });
      if (submitButton) submitButton.disabled = true;
      form.setAttribute('aria-busy', 'true');
      if (status) status.textContent = labels.sending;
      const result = await submit({
        form: form.dataset.variant || 'contact', name, phone: phoneRaw,
        interest: value('interest'), type: value('type'), budget: value('budget'), location: value('location'), message: msg || null,
        listing_id: listing, page: window.location.pathname, locale: document.documentElement.lang === 'ar' ? 'ar' : 'en',
      }, {
        attr: attr && attr.anon_id ? { anon_id: attr.anon_id, session_id: attr.session?.id ?? null, ref: sessionRef ?? null, first: attr.first ?? null, last: attr.last ?? null, fbp: attr.fbp ?? null, fbc: attr.fbc ?? null, ga: attr.ga ?? null, scid: attr.scid ?? null, ttp: attr.ttp ?? null } : null,
        consent: consentFlags(),
      });
      busy = false;
      draftFields.forEach(el => { el.disabled = false; });
      if (submitButton) submitButton.disabled = false;
      form.removeAttribute('aria-busy');
      if (status) status.textContent = result.ok ? labels.accepted : result.reason === 'rate_limited' ? labels.rateLimited : labels.failed;
      if (submitLabel) submitLabel.textContent = result.ok ? labels.send : labels.retry;
      if (result.ok && !result.duplicate) {
        try { w.bonaTrack?.('form_submit', { form: form.dataset.variant || 'contact' }, { eventId: result.eventId }); } catch { /* optional analytics */ }
      }
      status?.focus({ preventScroll: true });

    });
  }
  const init = () => document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach(initForm);
  document.addEventListener('astro:page-load', init);
</script>
