---
/* Listing gallery (round 2): a full-bleed horizontal scroll-snap strip with a progress bar, and a <dialog> lightbox
   built on a scroll-snap track (native swipe on touch, keyboard arrows, Escape) with a thumbnail rail.
   The first image carries the shared-element transition name from the listing cards. */
import Icon from './Icon.astro';
import { t, ui, fill, type Locale, count } from '../lib/i18n';
import { imageAlt, type Listing } from '../lib/listings';
interface Props { listing: Listing; locale: Locale }
const { listing: l, locale } = Astro.props;
const images = l.images ?? [];
const rtl = locale === 'ar';
---
<div data-gallery class="gallery">
  {images.length > 0 && (
    <div class="strip no-scrollbar" data-strip tabindex="0" role="region" aria-label={t(ui.gallery, locale)}>
      {images.map((img, i) => (
        <button type="button" class="strip-slide img-zoom" data-lb-open={i} aria-label={`${t(ui.openGallery, locale)} ${i + 1}`}>
          {i === 0
            ? <img src={img.src} alt={imageAlt(img, l, locale)} fetchpriority="high" decoding="async" transition:name={`listing-${l.slug}`} class="h-full w-full object-cover" />
            : <img src={img.thumb ?? img.src} srcset={img.thumb ? `${img.thumb} 400w, ${img.src} 1920w` : undefined} sizes="(min-width: 1024px) 60vw, 88vw" alt={imageAlt(img, l, locale)} loading="lazy" decoding="async" class="h-full w-full object-cover" />}
        </button>
      ))}
    </div>
  )}
  {images.length > 1 && (
    <div class="wrap mt-4 flex items-center gap-6">
      <div class="strip-progress" data-strip-progress role="progressbar" aria-label={t(ui.galleryProgress, locale)} aria-valuemin="1" aria-valuemax={images.length} aria-valuenow="1"><i></i></div>
      <p class="label shrink-0 text-stone" dir="ltr"><span data-strip-current>1</span> / {images.length}</p>
      <div class="hidden shrink-0 gap-2 md:flex">
        <button type="button" class="strip-btn" data-strip-prev aria-label={t(ui.previousImage, locale)}><Icon name={rtl ? 'chevron-right' : 'chevron-left'} size={18} /></button>
        <button type="button" class="strip-btn" data-strip-next aria-label={t(ui.nextImage, locale)}><Icon name={rtl ? 'chevron-left' : 'chevron-right'} size={18} /></button>
      </div>
      <p class="label ms-auto hidden text-stone sm:block">{count(images.length, 'photo', locale)}</p>
    </div>
  )}

  <dialog class="lightbox" data-lightbox aria-label={t(ui.gallery, locale)}>
    <div class="absolute inset-x-0 top-0 z-[2] flex items-center justify-between px-4 py-4">
      <p class="label text-ivory/80" dir="ltr"><span data-lb-current>1</span> / {images.length}</p>
      <button type="button" class="lb-btn !static" data-lb-close aria-label={t(ui.close, locale)}><Icon name="close" size={22} /></button>
    </div>
    <button type="button" class="lb-btn top-1/2 -translate-y-1/2 start-3" data-lb-prev aria-label={t(ui.previousImage, locale)}><Icon name={rtl ? 'chevron-right' : 'chevron-left'} size={22} /></button>
    <button type="button" class="lb-btn top-1/2 -translate-y-1/2 end-3" data-lb-next aria-label={t(ui.nextImage, locale)}><Icon name={rtl ? 'chevron-left' : 'chevron-right'} size={22} /></button>
    <div class="track no-scrollbar" data-lb-track tabindex="0">
      {images.map((img, i) => (
        <figure class="slide m-0" data-lb-slide={i}>
          <img data-src={img.src} alt={imageAlt(img, l, locale)} decoding="async" loading="lazy" />
        </figure>
      ))}
    </div>
    {images.length > 1 && (
      <div class="lb-rail no-scrollbar" data-lb-rail role="group" aria-label={t(ui.thumbnails, locale)}>
        {images.map((img, i) => (
          <button type="button" class="lb-thumb" data-lb-go={i} aria-label={fill(t(ui.goToImage, locale), { n: i + 1 })} aria-current={i === 0 ? 'true' : undefined}>
            <img src={img.thumb ?? img.src} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    )}
  </dialog>
</div>

<script>
  function initGallery(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const rtl = document.documentElement.dir === 'rtl';

    /* ---- Strip: progress + arrows ---- */
    const strip = root.querySelector<HTMLElement>('[data-strip]');
    if (strip) {
      const slides = Array.from(strip.querySelectorAll<HTMLElement>('.strip-slide'));
      const fill = root.querySelector<HTMLElement>('[data-strip-progress] i');
      const bar = root.querySelector<HTMLElement>('[data-strip-progress]');
      const cur = root.querySelector<HTMLElement>('[data-strip-current]');
      const update = () => {
        const max = strip.scrollWidth - strip.clientWidth;
        const x = Math.abs(strip.scrollLeft);
        const p = max > 0 ? Math.min(1, x / max) : 1;
        if (fill) fill.style.transform = `scaleX(${Math.max(p, 1 / Math.max(1, slides.length))})`;
        const i = Math.round(p * (slides.length - 1));
        if (cur) cur.textContent = String(i + 1);
        bar?.setAttribute('aria-valuenow', String(i + 1));
      };
      strip.addEventListener('scroll', update, { passive: true });
      update();
      const step = (dir: 1 | -1) => {
        const w = (slides[0]?.offsetWidth || strip.clientWidth) + 16;
        strip.scrollBy({ left: dir * w * (rtl ? -1 : 1), behavior: 'smooth' });
      };
      root.querySelector('[data-strip-prev]')?.addEventListener('click', () => step(-1));
      root.querySelector('[data-strip-next]')?.addEventListener('click', () => step(1));
    }

    /* ---- Lightbox ---- */
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const track = root.querySelector<HTMLElement>('[data-lb-track]');
    if (!dialog || !track || typeof dialog.showModal !== 'function') return;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-lb-slide]'));
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-lb-go]'));
    const current = root.querySelector<HTMLElement>('[data-lb-current]');
    let index = 0;

    const load = (i: number) => {
      for (const j of [i - 1, i, i + 1]) {
        const img = slides[j]?.querySelector<HTMLImageElement>('img[data-src]');
        if (img) { img.src = img.dataset.src!; img.removeAttribute('data-src'); }
      }
    };
    const mark = (i: number) => {
      if (current) current.textContent = String(i + 1);
      thumbs.forEach((th, j) => { if (j === i) { th.setAttribute('aria-current', 'true'); th.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' }); } else th.removeAttribute('aria-current'); });
    };
    const go = (i: number, smooth = true) => {
      index = (i + slides.length) % slides.length;
      load(index);
      slides[index].scrollIntoView({ inline: 'start', block: 'nearest', behavior: smooth ? 'smooth' : 'auto' });
      mark(index);
    };
    const open = (i: number) => {
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => go(i, false));
    };
    const close = () => { dialog.close(); };
    dialog.addEventListener('close', () => { document.body.style.overflow = ''; });

    root.querySelectorAll<HTMLElement>('[data-lb-open]').forEach(btn => btn.addEventListener('click', () => open(Number(btn.dataset.lbOpen) || 0)));
    thumbs.forEach(th => th.addEventListener('click', () => go(Number(th.dataset.lbGo) || 0)));
    root.querySelector('[data-lb-close]')?.addEventListener('click', close);
    root.querySelector('[data-lb-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-lb-next]')?.addEventListener('click', () => go(index + 1));
    dialog.addEventListener('click', e => { const el = e.target as HTMLElement; if (el === dialog || (el.closest('figure') && el.tagName !== 'IMG' && !el.closest('button'))) close(); });
    dialog.addEventListener('keydown', e => {
      const next = rtl ? 'ArrowLeft' : 'ArrowRight', prev = rtl ? 'ArrowRight' : 'ArrowLeft';
      if (e.key === next) { e.preventDefault(); go(index + 1); }
      else if (e.key === prev) { e.preventDefault(); go(index - 1); }
    });

    // Keep the counter and rail in sync with native swipe/scroll.
    const io = new IntersectionObserver(entries => {
      for (const en of entries) if (en.isIntersecting) {
        index = Number((en.target as HTMLElement).dataset.lbSlide) || 0;
        load(index);
        mark(index);
      }
    }, { root: track, threshold: 0.6 });
    slides.forEach(s => io.observe(s));
  }
  const init = () => document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
  document.addEventListener('astro:page-load', init);
</script>
