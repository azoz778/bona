---
/* Small inline icon set. Stroke icons inherit currentColor. */
interface Props { name: 'whatsapp' | 'instagram' | 'phone' | 'menu' | 'close' | 'chevron-left' | 'chevron-right' | 'pin' | 'clock' | 'download' | 'tour' | 'external' | 'check'; class?: string; size?: number }
const { name, class: cls = '', size = 20 } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'whatsapp' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m0 1.67c4.54 0 8.24 3.7 8.24 8.24s-3.7 8.24-8.24 8.24c-1.51 0-2.98-.41-4.27-1.19l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.34c0-4.54 3.7-8.24 8.24-8.24m-3.4 4.03c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.6c.12.17 1.76 2.68 4.25 3.76 2.07.82 2.49.65 2.94.61.45-.04 1.45-.59 1.65-1.16.2-.57.2-1.06.14-1.16-.06-.1-.23-.17-.48-.29s-1.45-.72-1.68-.8c-.23-.08-.39-.12-.55.12-.17.25-.63.8-.77.96-.14.17-.29.19-.53.06-.25-.12-1.03-.38-1.97-1.21-.73-.65-1.22-1.45-1.36-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42-.14-.01-.3-.01-.47-.01"/></svg>
)}
{name === 'instagram' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".8" fill="currentColor" stroke="none"/></svg>
)}
{name === 'phone' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3.5 5.5a2 2 0 0 1 2-2z"/></svg>
)}
{name === 'menu' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M3 7h18M3 12h18M3 17h18"/></svg>
)}
{name === 'close' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5 5l14 14M19 5L5 19"/></svg>
)}
{name === 'chevron-left' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M15 5l-7 7 7 7"/></svg>
)}
{name === 'chevron-right' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M9 5l7 7-7 7"/></svg>
)}
{name === 'pin' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
)}
{name === 'clock' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
)}
{name === 'download' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14"/></svg>
)}
{name === 'tour' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c3 3 3 14 0 17M12 3.5c-3 3-3 14 0 17"/></svg>
)}
{name === 'external' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M14 5h5v5M19 5l-8 8M17 14v5H5V7h5"/></svg>
)}
{name === 'check' && (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
)}
