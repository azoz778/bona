---
import ListingPage from '../../../components/pages/ListingPage.astro';
import PropertiesPage from '../../../components/pages/PropertiesPage.astro';
import { listings, kindsPresent, kindSlug, reservedSlugs, type Kind, type Listing } from '../../../lib/listings';
export function getStaticPaths() {
  const kindPages = kindsPresent().filter(k => k === 'land' || k === 'building').map(k => ({ params: { slug: kindSlug[k] }, props: { kind: k } }));
  const listingPages = listings.filter(l => !reservedSlugs.has(l.slug)).map(listing => ({ params: { slug: listing.slug }, props: { listing } }));
  return [...kindPages, ...listingPages];
}
const { listing, kind } = Astro.props as { listing?: Listing; kind?: Kind };
---
{kind ? <PropertiesPage locale="ar" kind={kind} /> : <ListingPage locale="ar" listing={listing!} />}
